def git_out(root, *args):
    r = run(["git", "-C", str(root), *args], check=False)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def normalize_remote(url):
    """git@github.com:Org/Repo.git, https://github.com/org/repo → github.com/org/repo (None: remote is a path)."""
    u = (url or "").strip()
    if "://" in u:
        parts = urllib.parse.urlsplit(u)
        if parts.scheme == "file":
            return None
        host, path = parts.hostname or "", parts.path
    elif re.match(r"^[^/\\]+:[^/\\]", u) and not re.match(r"^[A-Za-z]:[/\\]", u):  # scp: [user@]host:path
        host, path = u.split(":", 1)
        host = host.split("@")[-1]
    else:
        return None
    path = path.strip("/")
    path = path[:-4] if path.endswith(".git") else path
    return f"{host.lower()}/{path.lower()}" if host and path else None


def repo_identity(root):
    """→ (repo key, origin URL). Keyed by origin so every clone shares it; no remote: path."""
    url = git_out(root, "remote", "get-url", "origin")
