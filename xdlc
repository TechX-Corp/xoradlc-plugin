# ── git: Local keeps xdlc files untracked ─────────────────────────────────────────────────────────────

def git_root(path):
    r = run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    return Path(r.stdout.strip()).resolve() if r.returncode == 0 else None


def git_tracked(base, rels):
    """Which rels (relative to base) are currently tracked by git."""
    if not rels or not git_root(base):
        return []
    r = run(["git", "-C", str(base), "ls-files", "--", *rels], check=False)
    return sorted(set(r.stdout.split()) & set(rels)) if r.returncode == 0 else []


def _exclude_file(base):
    r = run(["git", "-C", str(base), "rev-parse", "--git-path", "info/exclude"], check=False)
    p = Path(r.stdout.strip())
    return p if p.is_absolute() else Path(base) / p


def set_exclude(base, rels):
    """xdlc block for base in .git/info/exclude (this machine only, not committed); empty rels = remove block."""
    root = git_root(base)
    if not root:
        return
    prefix = Path(base).resolve().relative_to(root).as_posix()
    begin = f"# xdlc:begin {prefix if prefix != '.' else '/'} (Xora DLC, Local)"
    f = _exclude_file(base)
    lines = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
    if begin in lines:
        a = lines.index(begin)
        b = next((i for i in range(a, len(lines)) if lines[i] == EXCLUDE_END), a)
        lines = lines[:a] + lines[b + 1:]
    if rels:
        pre = "" if prefix == "." else prefix + "/"
        lines += [begin] + ["/" + pre + r for r in sorted(rels)] + [EXCLUDE_END]
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")


def local_git(base, rels, old, interactive):
    """Local: xdlc files already tracked by git → ask to untrack or keep. → 'untrack' | 'keep' | None."""
    tracked = git_tracked(base, rels)
    if not tracked:
        return None
    if old and old.get("git_tracked") in ("untrack", "keep"):  # choice from a previous setup
        choice = old["git_tracked"]
    elif not interactive:
        return "keep"
    else:
        print("These files are already tracked by git in this repo:")
        for r in tracked:
            print(f"  {r}")
        choice = choose("Local means git does not track xdlc files. Choose:", [
            ("untrack", "Untrack (git rm --cached): files stay on disk; when you commit, they leave the team repo too"),
            ("keep", "Keep as-is: git still tracks them; xdlc changes will show in git status"),
        ])
    if choice == "untrack":
        run(["git", "-C", str(base), "rm", "--cached", "-q", "--", *tracked], check=False)
        print("Untracked from git (not committed). Commit this change if you want them removed from the team repo.")
    return choice


# ── repo, branch work order, pre-push hook ───────────────────────────────────────────────────────────

ZERO = "0" * 40
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"  # git empty tree: first branch push to remote
PRE_PUSH_MARK = "# xdlc pre-push (Xora DLC)"


def git_out(root, *args):
    r = run(["git", "-C", str(root), *args], check=False)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None


def normalize_remote(url):
    """git@github.com:Org/Repo.git, https://github.com/org/repo → github.com/org/repo (None: remote is a path)."""
    u = (url or "").strip()
    if "://" in u:
        parts = urllib.parse.urlsplit(u)
        if parts.scheme == "file":
            return None
        host, path = parts.hostname or "", parts.path
    elif re.match(r"^[^/\\]+:[^/\\]", u) and not re.match(r"^[A-Za-z]:[/\\]", u):  # scp: [user@]host:path
        host, path = u.split(":", 1)
        host = host.split("@")[-1]
    else:
        return None
    path = path.strip("/")
    path = path[:-4] if path.endswith(".git") else path
    return f"{host.lower()}/{path.lower()}" if host and path else None


def repo_identity(root):
    """→ (repo key, origin URL). Keyed by origin so every clone shares it; no remote: path."""
    url = git_out(root, "remote", "get-url", "origin")
    return normalize_remote(url) or "path:" + Path(root).resolve().as_posix(), url or ""


def links():
    return load_json(XDLC / "links.json", {})


def link_of(repo_id, branch, env=None):
    return links().get(env or config()["env"], {}).get(repo_id, {}).get(branch)


def save_link(repo_id, branch, step):
    data = links()
    data.setdefault(config()["env"], {}).setdefault(repo_id, {})[branch] = {
        k: step.get(k) for k in ("work_order_id", "work_order_name", "step_id", "step_name")}
    save_json(XDLC / "links.json", data)


def step_label(s):
    return f"{s['work_order_id']} · {s.get('work_order_name') or ''} · {s.get('step_name') or s['step_id']}"


def api(method, path, body=None, timeout=15):
    """Call backend with login token (auto-refresh once on 401). → (status, json) | (None, None) if not logged in."""
    token = access_token()
    if not token:
        return None, None
    status, out = request(method, base_url() + path, body=body, token=token, timeout=timeout)
    if status == 401 and (token := access_token(force_refresh=True)):
        status, out = request(method, base_url() + path, body=body, token=token, timeout=timeout)
    return status, out


def my_steps():
    """Steps you are working on (My Work: steps_in_progress) on the current backend."""
    status, out = api("GET", "/my-work")
    if status is None:
        raise Abort("Not logged in to Xora DLC: run xdlc login.")
    if status == 0:
        raise Abort(f"Could not connect to {base_url()} ({out}).")
    if status != 200 or not isinstance(out, dict):
        raise Abort(f"Could not load My Work (HTTP {status}): {out}")
    return [s for s in out.get("steps_in_progress") or [] if s.get("work_order_id") and s.get("step_id")]


def pick_step(branch, steps):
    return steps[choose(f"Map branch {branch} to which step? (My Work on {config()['env']})",
                        [(i, step_label(st)) for i, st in enumerate(steps)])]


def hooks_dir(root):
    """Repo hooks directory; None when the repo uses core.hooksPath (husky, …): xdlc does not write there."""
    if git_out(root, "config", "core.hooksPath"):
        return None
    p = git_out(root, "rev-parse", "--git-path", "hooks")
    if not p:
        return None
    p = Path(p)
    return p if p.is_absolute() else Path(root) / p


def _ours(f):
    try:
        return PRE_PUSH_MARK in Path(f).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def pre_push_of(root):
    d = hooks_dir(root)
    f = d / "pre-push" if d else None
    return f if f and f.is_file() and _ours(f) else None


def pre_push_line():
    return f'{shell_cmd(xdlc_argv())} sensor --pre-push "$@" || true'


def install_pre_push(root):
    """xdlc git pre-push hook (rewrite if it is ours). → True when the repo has that hook."""
    d = hooks_dir(root)
    if d is None:
        print("Repo uses core.hooksPath (e.g. husky): xdlc will not install pre-push. Add this line to the repo's "
              f"pre-push hook:\n  {pre_push_line()}")
        return False
    f = d / "pre-push"
    if f.exists() and not _ours(f):
        print(f"Repo already has its own pre-push hook ({short(f)}): xdlc will not overwrite. Add this line to that hook:\n"
              f"  {pre_push_line()}")
        return False
    d.mkdir(parents=True, exist_ok=True)
    with open(f, "w", encoding="utf-8", newline="\n") as out:  # git runs hooks with sh, including on Windows
        out.write(f"#!/bin/sh\n{PRE_PUSH_MARK}: check conventions, send alerts to Xora DLC. Does not block push.\n"
                  f"# Remove: xdlc remove / xdlc uninstall\n{pre_push_line()}\nexit 0\n")
    os.chmod(f, 0o755)
    reg = load_json(XDLC / "hooks.json", [])
    if str(f) not in reg:
        save_json(XDLC / "hooks.json", reg + [str(f)])
    return True


def remove_pre_push(f):
    f = Path(f)
    if f.is_file() and _ours(f):
        f.unlink()
    save_json(XDLC / "hooks.json", [h for h in load_json(XDLC / "hooks.json", []) if h != str(f)])


def pre_push_still_needed(root, items):
    """Any Local setup in this repo, or any branch already mapped to a work order → keep the hook."""
    if any(r["scope"] == "local" and Path(r["path"]).is_dir() and git_root(r["path"]) == root for r in items):
        return True
    repo_id, _ = repo_identity(root)
    return any(repo_id in per_env for per_env in links().values())


def _attach_tty():
    """pre-push hook: stdin is git's ref list; to prompt, read from the terminal (none: skip)."""
    if os.environ.get("XDLC_NO_TTY"):
        return False
    try:
        sys.stdin = open("CONIN$" if WINDOWS else "/dev/tty", encoding="utf-8")
        return sys.stdin.isatty()
    except OSError:
        return False


def pre_push(argv):
    """xdlc sensor --pre-push <remote> <url> (git hook): check files in the upcoming push, send alerts to
    Xora DLC for the work order mapped to the branch. Alerts only: every error is printed, then push continues."""
    remote = argv[0] if argv else "origin"
    refs = [ln.split() for ln in sys.stdin.read().splitlines() if ln.strip()]
    root = git_root(Path.cwd())
    sensor = BUNDLE / "agents-plugin" / "dev" / "sensor" / "convention_sensor.py"
    if not root or not sensor.is_file():
        err("xdlc pre-push: plugin not on this machine (xdlc setup), skipping.")
        return
    repo_id, origin = repo_identity(root)
    tty = None
    for parts in refs:
        if len(parts) != 4 or parts[1] == ZERO or not parts[2].startswith("refs/heads/"):
            continue  # delete branch, tag
        local_sha, remote_sha, branch = parts[1], parts[3], parts[2][len("refs/heads/"):]
        base = remote_sha if remote_sha != ZERO else (
            git_out(root, "merge-base", local_sha, f"refs/remotes/{remote}/HEAD")
            or git_out(root, "rev-parse", "--verify", "-q", f"{local_sha}^") or EMPTY_TREE)
        files = (git_out(root, "diff", "--name-only", "--diff-filter=d", base, local_sha) or "").splitlines()
        files = [str(root / f) for f in files if (root / f).is_file()]
        if not files:
            continue
        r = subprocess.run([sys.executable, str(sensor), "--json", "--base", base, *files], cwd=root,
                           capture_output=True, text=True, encoding="utf-8", errors="replace",
                           env={**os.environ, "PYTHONUTF8": "1"})
        try:
            result = json.loads(r.stdout)
        except ValueError:
            err(f"xdlc pre-push: sensor error, skipping ({(r.stderr or r.stdout).strip()[:200]})")
            continue
        found = result.get("findings") or []
        if not found:
            print(f"xdlc: no convention alerts on branch {branch}.")
            continue  # nothing to send (also do not ask for work order)
        print(f"xdlc: {len(found)} convention alert(s) on branch {branch} ({len(files)} changed file(s)).")
        for x in found[:20]:
            fix = f" → {x['fix']}" if x.get("fix") else ""
            print(f"  - {x['file']}{':' + str(x['line']) if x.get('line') else ''} [{x['rule_code']}] {x['message']}{fix}")
        if len(found) > 20:
            print(f"  … and {len(found) - 20} more alert(s)")
        step = link_of(repo_id, branch)
        if not step:
            if tty is None:
                tty = _attach_tty()
            if not tty:
                print(f"xdlc: branch {branch} has no work order mapped: not sending this time. Run xdlc link in the repo.")
                continue
            try:
                steps = my_steps()
                if not steps:
                    print("xdlc: you have no in-progress steps in Xora DLC: not sending.")
                    continue
                step = pick_step(branch, steps)
                save_link(repo_id, branch, step)
            except Abort as e:
                print(f"xdlc: {e} Not sending this time.")
                continue
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        body = {"work_order_id": step["work_order_id"], "step_id": step["step_id"],
                "machine": (platform.node() or "unknown")[:120], "session_id": f"git-push:{branch}"[:120],
                "repo": (origin or repo_id)[:300], "commit": local_sha[:64],
                "findings": [{"file": x["file"][:500], "line": x.get("line"), "rule_code": x["rule_code"][:32],
                              "severity": x["severity"], "message": x["message"][:300], "at": now}
                             for x in found[:500]]}
        status, out = api("POST", "/governance/sensor-events", body)
        where = f"{step['work_order_id']} · {step.get('step_name') or step['step_id']}"
        if status is None:
            print("xdlc: not logged in to Xora DLC (xdlc login): not sending alerts.")
        elif status == 201:
            print(f"xdlc: sent {len(body['findings'])} alert(s) to Xora DLC ({where}).")
        elif status == 403:
            print(f"xdlc: you are not a Dev on {where}: not sending. Remap with xdlc link.")
        elif status == 0:
            print(f"xdlc: could not connect to {base_url()}: not sending ({out}).")
        else:
            detail = out.get("error", {}).get("detail") if isinstance(out, dict) else out
            print(f"xdlc: Xora DLC rejected (HTTP {status}): {detail}")


# ── Kiro ────────────────────────────────────────────────────────────────────────────────────────────────

MCP_REL = ".kiro/settings/mcp.json"


def kiro_files(src, scope):
    """(source, dest relative to root): skill, steering, hook JSON v1 (Kiro CLI V3 loads both workspace .kiro/hooks
    and ~/.kiro/hooks)."""
    out = [(f, Path(".kiro/skills") / f.relative_to(src / "skills"))
           for f in sorted((src / "skills").rglob("*")) if f.is_file()]
    out.append((src / "AGENTS.md", Path(".kiro/steering/xora-dev.md")))
    out += [(f, Path(".kiro/steering") / f.name) for f in sorted((src / "steering").glob("*.md"))]
    out += [(f, Path(".kiro/hooks") / f.name) for f in sorted((src / "kiro-hooks").glob("*.json"))]
    return out


def remove_file(base, rel, digest, interactive):
    p = base / rel
    if not p.is_file():
        return
    if sha256(p) != digest and not (interactive and confirm(f"  {short(p)} was modified after install. Delete anyway?")):
        print(f"  Keeping {short(p)} (modified).")
        return
    p.unlink()
    d = p.parent
    while d != base and d.name != ".kiro" and d.is_dir() and not any(d.iterdir()):
        d.rmdir()
        d = d.parent


def setup_kiro(bundle, scope, path, old, interactive):
    src, base = bundle / "dev", Path(path)
    mcp_file = base / MCP_REL
    plan = kiro_files(src, scope)
    git_choice = local_git(base, [r.as_posix() for _, r in plan] + [MCP_REL], old, interactive) if scope == "local" else None
    files = {}
    for f, rel in plan:
        dst = base / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(f, dst)
        files[rel.as_posix()] = sha256(dst)
    for rel, digest in (old or {}).get("files", {}).items():  # files from the old version no longer in the new one
        if rel not in files:
            remove_file(base, rel, digest, interactive)
    created = (old or {}).get("created_mcp_json", not mcp_file.exists())
    cfg = load_json(mcp_file, {})
    cfg.setdefault("mcpServers", {})[SERVER] = {**mcp_entry(), "disabled": False, "autoApprove": []}
    save_json(mcp_file, cfg)
    rec = {"agent": "kiro", "scope": scope, "path": str(base), "version": bundle_version(),
           "files": files, "mcp_json": MCP_REL, "created_mcp_json": created, "git_tracked": git_choice}
    if scope == "local":
        excluded = [r for r in files if git_choice != "keep" or r not in git_tracked(base, [r])]
        if created or git_choice == "untrack":
            excluded.append(MCP_REL)
        set_exclude(base, excluded)
    return rec


def remove_kiro(rec, interactive):
    base = Path(rec["path"])
    for rel, digest in rec.get("files", {}).items():
        remove_file(base, rel, digest, interactive)
    mcp_file = base / rec["mcp_json"]
    cfg = load_json(mcp_file, None)
    if isinstance(cfg, dict):
        cfg.get("mcpServers", {}).pop(SERVER, None)
        if rec.get("created_mcp_json") and not cfg.get("mcpServers") and set(cfg) <= {"mcpServers"}:
            mcp_file.unlink()
            for d in (mcp_file.parent, mcp_file.parent.parent):
                if d.is_dir() and d.name != ".kiro" and not any(d.iterdir()):
                    d.rmdir()
        else:
            save_json(mcp_file, cfg)
    if rec["scope"] == "local":
        set_exclude(base, [])
    kiro = base / ".kiro"
    if kiro.is_dir() and not any(kiro.iterdir()) and base != HOME:
        kiro.rmdir()


