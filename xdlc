# ── local MCP server for the agent ─────────────────────────────────────────────────────────────────────

def _local_answer(msg, reason):
    m, mid = msg.get("method"), msg.get("id")
    if m == "initialize":
        asked = (msg.get("params") or {}).get("protocolVersion")
        result = {"protocolVersion": asked or "2025-06-18", "capabilities": {"tools": {"listChanged": False}},
                  "serverInfo": {"name": "xoradlc", "version": VERSION}}
    elif m == "ping":
        result = {}
    elif m == "tools/list":
        result = {"tools": [ASK_TOOL]}
    elif m == "tools/call":
        result = {"content": [{"type": "text", "text": reason}], "isError": True}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"Method not found: {m}"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def _forward(msg):
    url = base_url() + "/mcp/user"
    token = access_token()
    if token:
        status, out = request("POST", url, body=msg, token=token, timeout=600)
        if status == 401:
            token = access_token(force_refresh=True)
            if token:
                status, out = request("POST", url, body=msg, token=token, timeout=600)
        if status == 202 or (status == 200 and "id" not in msg):
            return None
        if status == 200 and isinstance(out, dict):
            return out
        if status == 0:
            reason = f"Could not connect to Xora DLC ({base_url()}): {out}. Check the network and ask again."
        elif status == 401:
            reason = "Xora DLC session expired. Run `xdlc login` in a terminal and ask again."
        else:
            reason = f"Xora DLC returned HTTP {status}: {out}"
    else:
        reason = (f"Not logged in to Xora DLC ({base_url()}). "
                  "Run `xdlc login` in a terminal and ask again.")
    if "id" not in msg:
        return None
    return _local_answer(msg, reason)


def cmd_mcp(argv):
    """stdio JSON-RPC ↔ Xora DLC /mcp/user. One thread per request: a long xora_ask does not block ping."""
    out_lock = threading.Lock()

    def handle(line):
        try:
            msg = json.loads(line)
        except ValueError:
            return
        try:
            resp = _forward(msg)
        except Exception as e:  # do not let one error kill the agent's server
            resp = None if "id" not in msg else {"jsonrpc": "2.0", "id": msg["id"],
                                                 "error": {"code": -32603, "message": f"xdlc: {e}"}}
        if resp is not None:
            with out_lock:
                sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
                sys.stdout.flush()

    threads = []
    for line in sys.stdin:
        if line.strip():
            t = threading.Thread(target=handle, args=(line,), daemon=True)
            t.start()
            threads.append(t)
    for t in threads:
        t.join()


def cmd_sensor(argv):
    """Fetch convention NL from AAP, or report structured findings to Governance."""
    if argv[:1] == ["--pre-push"]:
        pre_push(argv[1:])
        return
    if argv[:1] == ["report"]:
        rest = argv[1:]
        raw = None
        if rest[:1] == ["--file"] and len(rest) >= 2:
            raw = Path(rest[1]).read_text(encoding="utf-8")
        elif rest:
            raise Abort("xdlc sensor report [--file PATH]  (JSON findings on stdin if no --file)", 2)
        else:
            raw = sys.stdin.read()
        try:
            data = json.loads(raw)
        except ValueError as e:
            raise Abort(f"Invalid findings JSON: {e}", 2)
        found = data.get("findings") if isinstance(data, dict) else None
        if not isinstance(found, list) or not found:
            raise Abort("findings must be a non-empty list.", 2)
        root = git_root(Path.cwd())
        if not root:
            raise Abort("Not a git repo: cd into the repo and run again.")
        branch = git_out(root, "branch", "--show-current") or "(detached)"
        repo_id, origin = repo_identity(root)
        step = link_of(repo_id, branch)
        if not step:
            raise Abort(f"Branch {branch} has no work order mapped: run xdlc link.", 2)
        commit = (git_out(root, "rev-parse", "HEAD") or "")[:64]
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        findings = []
        for x in found[:500]:
            if not isinstance(x, dict):
                continue
            sev = x.get("severity") or "yellow"
            if sev in ("🔴", "red"):
                sev = "red"
            elif sev in ("🟡", "yellow"):
                sev = "yellow"
            else:
                sev = "yellow"
            findings.append({
                "file": str(x.get("file") or "")[:500],
                "line": x.get("line"),
                "rule_code": str(x.get("rule_code") or "AAP-NL")[:32],
                "severity": sev,
                "message": str(x.get("message") or "")[:300],
                "at": now,
            })
        if not findings or not findings[0]["file"]:
            raise Abort("Each finding needs file, rule_code, severity, message.", 2)
        body = {"work_order_id": step["work_order_id"], "step_id": step["step_id"],
                "machine": (platform.node() or "unknown")[:120], "session_id": f"agent-push:{branch}"[:120],
                "repo": (origin or repo_id)[:300], "commit": commit,
                "findings": findings}
        status, out = api("POST", "/governance/sensor-events", body)
        where = f"{step['work_order_id']} · {step.get('step_name') or step['step_id']}"
        if status is None:
            raise Abort("Not logged in to Xora DLC (xdlc login): not sending alerts.", 2)
        if status == 201:
            print(f"xdlc: sent {len(body['findings'])} alert(s) to Xora DLC ({where}).")
            return
        if status == 403:
            raise Abort(f"You are not a Dev on {where}: remap with xdlc link.", 2)
        if status == 0:
            raise Abort(f"Could not connect to {base_url()}: ({out}).", 2)
        detail = out.get("error", {}).get("detail") if isinstance(out, dict) else out
        raise Abort(f"Xora DLC rejected (HTTP {status}): {detail}", 2)

    if argv:
        raise Abort("xdlc sensor | xdlc sensor report [--file PATH]", 2)
    root = git_root(Path.cwd()) or Path.cwd()
    text = ask_aap(CONVENTION_ASK_PROMPT)
    print("Convention (from AAP / KB):")
    print(text.rstrip())
    print()
    files = changed_files(root) if git_root(Path.cwd()) else []
    if files:
        print("Changed files:")
        for f in files:
            print(f"  {f}")
    else:
        print("Changed files: (none detected)")


