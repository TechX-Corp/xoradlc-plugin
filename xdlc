    data.setdefault(config()["env"], {}).setdefault(repo_id, {})[branch] = {
        k: step.get(k) for k in ("work_order_id", "work_order_name", "step_id", "step_name")}
    save_json(XDLC / "links.json", data)


def step_label(s):
    return f"{s['work_order_id']} · {s.get('work_order_name') or ''} · {s.get('step_name') or s['step_id']}"


def api(method, path, body=None, timeout=15):
    """Gọi backend bằng token đăng nhập (tự làm mới một lần khi 401). → (status, json) | (None, None) chưa đăng nhập."""
    token = access_token()
    if not token:
        return None, None
    status, out = request(method, base_url() + path, body=body, token=token, timeout=timeout)
    if status == 401 and (token := access_token(force_refresh=True)):
        status, out = request(method, base_url() + path, body=body, token=token, timeout=timeout)
    return status, out


def my_steps():
    """Các bước bạn đang làm (Việc của tôi: steps_in_progress) trên backend đang dùng."""
    status, out = api("GET", "/my-work")
    if status is None:
        raise Abort("Chưa đăng nhập Xora DLC: chạy xdlc login.")
    if status == 0:
        raise Abort(f"Không kết nối được {base_url()} ({out}).")
    if status != 200 or not isinstance(out, dict):
        raise Abort(f"Không lấy được Việc của tôi (HTTP {status}): {out}")
    return [s for s in out.get("steps_in_progress") or [] if s.get("work_order_id") and s.get("step_id")]


def pick_step(branch, steps):
    return steps[choose(f"Map nhánh {branch} với bước nào? (Việc của tôi trên {config()['env']})",
                        [(i, step_label(st)) for i, st in enumerate(steps)])]


def hooks_dir(root):
    """Thư mục hook của repo; None khi repo dùng core.hooksPath (husky, …): xdlc không ghi vào đó."""
    if git_out(root, "config", "core.hooksPath"):
        return None
    p = git_out(root, "rev-parse", "--git-path", "hooks")
    if not p:
        return None
    p = Path(p)
    return p if p.is_absolute() else Path(root) / p


def _ours(f):
    try:
        return PRE_PUSH_MARK in Path(f).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False


def pre_push_of(root):
    d = hooks_dir(root)
    f = d / "pre-push" if d else None
    return f if f and f.is_file() and _ours(f) else None


def pre_push_line():
    return f'{shell_cmd(xdlc_argv())} sensor --pre-push "$@" || true'


def install_pre_push(root):
    """Hook git pre-push của xdlc (ghi lại nếu là của xdlc). → True khi repo có hook đó."""
    d = hooks_dir(root)
    if d is None:
        print("Repo dùng core.hooksPath (vd. husky): xdlc không tự cài pre-push. Thêm dòng sau vào hook "
              f"pre-push của repo:\n  {pre_push_line()}")
        return False
    f = d / "pre-push"
    if f.exists() and not _ours(f):
        print(f"Repo đã có hook pre-push riêng ({short(f)}): xdlc không ghi đè. Thêm dòng sau vào hook đó:\n"
              f"  {pre_push_line()}")
        return False
    d.mkdir(parents=True, exist_ok=True)
    with open(f, "w", encoding="utf-8", newline="\n") as out:  # git chạy hook bằng sh, cả trên Windows
        out.write(f"#!/bin/sh\n{PRE_PUSH_MARK}: kiểm convention, gửi cảnh báo về Xora DLC. Không chặn push.\n"
                  f"# Gỡ: xdlc remove / xdlc uninstall\n{pre_push_line()}\nexit 0\n")
    os.chmod(f, 0o755)
    reg = load_json(XDLC / "hooks.json", [])
    if str(f) not in reg:
        save_json(XDLC / "hooks.json", reg + [str(f)])
    return True


def remove_pre_push(f):
    f = Path(f)
    if f.is_file() and _ours(f):
        f.unlink()
    save_json(XDLC / "hooks.json", [h for h in load_json(XDLC / "hooks.json", []) if h != str(f)])


def pre_push_still_needed(root, items):
    """Còn setup Local nào ở repo này, hay nhánh nào của repo đã map work order → giữ hook."""
    if any(r["scope"] == "local" and Path(r["path"]).is_dir() and git_root(r["path"]) == root for r in items):
        return True
    repo_id, _ = repo_identity(root)
    return any(repo_id in per_env for per_env in links().values())


def _attach_tty():
    """Hook pre-push: stdin là danh sách ref của git; muốn hỏi thì đọc thẳng từ terminal (không có: thôi)."""
    if os.environ.get("XDLC_NO_TTY"):
        return False
    try:
        sys.stdin = open("CONIN$" if WINDOWS else "/dev/tty", encoding="utf-8")
        return sys.stdin.isatty()
    except OSError:
        return False


def pre_push(argv):
    """xdlc sensor --pre-push <remote> <url> (hook git): kiểm các file của commit sắp push, gửi cảnh báo về
    Xora DLC theo work order đã map với nhánh. Chỉ cảnh báo: mọi lỗi đều in ra rồi cho push tiếp."""
    remote = argv[0] if argv else "origin"
    refs = [ln.split() for ln in sys.stdin.read().splitlines() if ln.strip()]
    root = git_root(Path.cwd())
    sensor = BUNDLE / "agents-plugin" / "dev" / "sensor" / "convention_sensor.py"
    if not root or not sensor.is_file():
        err("xdlc pre-push: chưa có plugin trên máy (xdlc setup), bỏ qua.")
        return
    repo_id, origin = repo_identity(root)
    tty = None
    for parts in refs:
        if len(parts) != 4 or parts[1] == ZERO or not parts[2].startswith("refs/heads/"):
            continue  # xoá nhánh, tag
        local_sha, remote_sha, branch = parts[1], parts[3], parts[2][len("refs/heads/"):]
        base = remote_sha if remote_sha != ZERO else (
            git_out(root, "merge-base", local_sha, f"refs/remotes/{remote}/HEAD")
            or git_out(root, "rev-parse", "--verify", "-q", f"{local_sha}^") or EMPTY_TREE)
        files = (git_out(root, "diff", "--name-only", "--diff-filter=d", base, local_sha) or "").splitlines()
        files = [str(root / f) for f in files if (root / f).is_file()]
        if not files:
            continue
        r = subprocess.run([sys.executable, str(sensor), "--json", "--base", base, *files], cwd=root,
                           capture_output=True, text=True, encoding="utf-8", errors="replace",
                           env={**os.environ, "PYTHONUTF8": "1"})
        try:
            result = json.loads(r.stdout)
        except ValueError:
            err(f"xdlc pre-push: sensor lỗi, bỏ qua ({(r.stderr or r.stdout).strip()[:200]})")
            continue
        found = result.get("findings") or []
        if not found:
            print(f"xdlc: không có cảnh báo convention trên nhánh {branch}.")
            continue  # không có gì để gửi (cũng không hỏi work order)
        print(f"xdlc: {len(found)} cảnh báo convention trên nhánh {branch} ({len(files)} file thay đổi).")
        for x in found[:20]:
            fix = f" → {x['fix']}" if x.get("fix") else ""
            print(f"  - {x['file']}{':' + str(x['line']) if x.get('line') else ''} [{x['rule_code']}] {x['message']}{fix}")
        if len(found) > 20:
            print(f"  … và {len(found) - 20} cảnh báo khác")
        step = link_of(repo_id, branch)
        if not step:
            if tty is None:
                tty = _attach_tty()
            if not tty:
                print(f"xdlc: nhánh {branch} chưa map work order: không gửi lần này. Chạy xdlc link trong repo.")
                continue
            try:
                steps = my_steps()
                if not steps:
                    print("xdlc: bạn không có bước nào đang làm trong Xora DLC: không gửi.")
                    continue
                step = pick_step(branch, steps)
                save_link(repo_id, branch, step)
            except Abort as e:
                print(f"xdlc: {e} Không gửi lần này.")
                continue
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        body = {"work_order_id": step["work_order_id"], "step_id": step["step_id"],
                "machine": (platform.node() or "unknown")[:120], "session_id": f"git-push:{branch}"[:120],
                "repo": (origin or repo_id)[:300], "commit": local_sha[:64],
                "findings": [{"file": x["file"][:500], "line": x.get("line"), "rule_code": x["rule_code"][:32],
                              "severity": x["severity"], "message": x["message"][:300], "at": now}
                             for x in found[:500]]}
        status, out = api("POST", "/governance/sensor-events", body)
        where = f"{step['work_order_id']} · {step.get('step_name') or step['step_id']}"
        if status is None:
            print("xdlc: chưa đăng nhập Xora DLC (xdlc login): không gửi cảnh báo.")
        elif status == 201:
            print(f"xdlc: đã gửi {len(body['findings'])} cảnh báo về Xora DLC ({where}).")
        elif status == 403:
            print(f"xdlc: bạn không phải Dev của {where}: không gửi. Chọn lại bằng xdlc link.")
        elif status == 0:
            print(f"xdlc: không kết nối được {base_url()}: không gửi ({out}).")
        else:
            detail = out.get("error", {}).get("detail") if isinstance(out, dict) else out
            print(f"xdlc: Xora DLC từ chối (HTTP {status}): {detail}")


# ── Kiro ────────────────────────────────────────────────────────────────────────────────────────────────

MCP_REL = ".kiro/settings/mcp.json"


def kiro_files(src, scope):
    """(nguồn, đích tương đối với thư mục gốc): skill, steering, hook JSON v1 (Kiro CLI V3 nạp cả .kiro/hooks
    của workspace lẫn ~/.kiro/hooks)."""
    out = [(f, Path(".kiro/skills") / f.relative_to(src / "skills"))
           for f in sorted((src / "skills").rglob("*")) if f.is_file()]
    out.append((src / "AGENTS.md", Path(".kiro/steering/xora-dev.md")))
    out += [(f, Path(".kiro/steering") / f.name) for f in sorted((src / "steering").glob("*.md"))]
    out += [(f, Path(".kiro/hooks") / f.name) for f in sorted((src / "kiro-hooks").glob("*.json"))]
    return out


def remove_file(base, rel, digest, interactive):
    p = base / rel
    if not p.is_file():
        return
    if sha256(p) != digest and not (interactive and confirm(f"  {short(p)} đã bị sửa sau khi cài. Vẫn xoá?")):
        print(f"  Giữ lại {short(p)} (đã sửa).")
        return
    p.unlink()
    d = p.parent
    while d != base and d.name != ".kiro" and d.is_dir() and not any(d.iterdir()):
        d.rmdir()
        d = d.parent


def setup_kiro(bundle, scope, path, old, interactive):
    src, base = bundle / "dev", Path(path)
    mcp_file = base / MCP_REL
    plan = kiro_files(src, scope)
    git_choice = local_git(base, [r.as_posix() for _, r in plan] + [MCP_REL], old, interactive) if scope == "local" else None
    files = {}
    for f, rel in plan:
        dst = base / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(f, dst)
        files[rel.as_posix()] = sha256(dst)
    for rel, digest in (old or {}).get("files", {}).items():  # file của bản cũ không còn trong bản mới
        if rel not in files:
            remove_file(base, rel, digest, interactive)
    created = (old or {}).get("created_mcp_json", not mcp_file.exists())
    cfg = load_json(mcp_file, {})
    cfg.setdefault("mcpServers", {})[SERVER] = {**mcp_entry(), "disabled": False, "autoApprove": []}
    save_json(mcp_file, cfg)
    rec = {"agent": "kiro", "scope": scope, "path": str(base), "version": bundle_version(),
           "files": files, "mcp_json": MCP_REL, "created_mcp_json": created, "git_tracked": git_choice}
    if scope == "local":
        excluded = [r for r in files if git_choice != "keep" or r not in git_tracked(base, [r])]
        if created or git_choice == "untrack":
            excluded.append(MCP_REL)
        set_exclude(base, excluded)
    return rec


def remove_kiro(rec, interactive):
    base = Path(rec["path"])
    for rel, digest in rec.get("files", {}).items():
        remove_file(base, rel, digest, interactive)
    mcp_file = base / rec["mcp_json"]
    cfg = load_json(mcp_file, None)
    if isinstance(cfg, dict):
        cfg.get("mcpServers", {}).pop(SERVER, None)
        if rec.get("created_mcp_json") and not cfg.get("mcpServers") and set(cfg) <= {"mcpServers"}:
            mcp_file.unlink()
            for d in (mcp_file.parent, mcp_file.parent.parent):
                if d.is_dir() and d.name != ".kiro" and not any(d.iterdir()):
                    d.rmdir()
        else:
            save_json(mcp_file, cfg)
    if rec["scope"] == "local":
        set_exclude(base, [])
    kiro = base / ".kiro"
    if kiro.is_dir() and not any(kiro.iterdir()) and base != HOME:
