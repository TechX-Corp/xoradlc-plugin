def _local_answer(msg, reason):
    m, mid = msg.get("method"), msg.get("id")
    if m == "initialize":
        asked = (msg.get("params") or {}).get("protocolVersion")
        result = {"protocolVersion": asked or "2025-06-18", "capabilities": {"tools": {"listChanged": False}},
                  "serverInfo": {"name": "xoradlc", "version": VERSION}}
    elif m == "ping":
        result = {}
    elif m == "tools/list":
        result = {"tools": [ASK_TOOL]}
    elif m == "tools/call":
        result = {"content": [{"type": "text", "text": reason}], "isError": True}
    else:
        return {"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": f"Method not found: {m}"}}
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def _forward(msg):
    c = config()
    url = base_url(c) + "/mcp/user"
    token = access_token()
    if token:
        status, out = request("POST", url, body=msg, token=token, timeout=600)
        if status == 401:
            token = access_token(force_refresh=True)
            if token:
                status, out = request("POST", url, body=msg, token=token, timeout=600)
        if status == 202 or (status == 200 and "id" not in msg):
            return None
        if status == 200 and isinstance(out, dict):
            return out
        if status == 0:
            reason = f"Không kết nối được Xora DLC ({base_url(c)}): {out}. Kiểm tra mạng / backend rồi hỏi lại."
        elif status == 401:
            reason = f"Phiên đăng nhập Xora DLC ({c['env']}) đã hết. Chạy `xdlc login` trong terminal rồi hỏi lại."
        else:
            reason = f"Xora DLC trả lỗi HTTP {status}: {out}"
    else:
        reason = (f"Chưa đăng nhập Xora DLC ({c['env']}: {base_url(c)}). "
                  "Chạy `xdlc login` trong terminal rồi hỏi lại.")
    if "id" not in msg:
        return None
    return _local_answer(msg, reason)


def cmd_mcp(argv):
    """stdio JSON-RPC ↔ <backend>/mcp/user. Mỗi yêu cầu một luồng: một xora_ask lâu không chặn ping."""
    out_lock = threading.Lock()

    def handle(line):
        try:
            msg = json.loads(line)
        except ValueError:
            return
        try:
            resp = _forward(msg)
        except Exception as e:  # không để một lỗi làm chết server của agent
            resp = None if "id" not in msg else {"jsonrpc": "2.0", "id": msg["id"],
                                                 "error": {"code": -32603, "message": f"xdlc: {e}"}}
        if resp is not None:
            with out_lock:
                sys.stdout.write(json.dumps(resp, ensure_ascii=False) + "\n")
                sys.stdout.flush()

    threads = []
    for line in sys.stdin:
        if line.strip():
            t = threading.Thread(target=handle, args=(line,), daemon=True)
            t.start()
            threads.append(t)
    for t in threads:
        t.join()


