def git_root(path):
    r = run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], check=False)
    return Path(r.stdout.strip()).resolve() if r.returncode == 0 else None


def git_tracked(base, rels):
    """Which rels (relative to base) are currently tracked by git."""
    if not rels or not git_root(base):
        return []
    r = run(["git", "-C", str(base), "ls-files", "--", *rels], check=False)
    return sorted(set(r.stdout.split()) & set(rels)) if r.returncode == 0 else []


def _exclude_file(base):
    r = run(["git", "-C", str(base), "rev-parse", "--git-path", "info/exclude"], check=False)
    p = Path(r.stdout.strip())
    return p if p.is_absolute() else Path(base) / p


def set_exclude(base, rels):
    """xdlc block for base in .git/info/exclude (this machine only, not committed); empty rels = remove block."""
    root = git_root(base)
    if not root:
        return
    prefix = Path(base).resolve().relative_to(root).as_posix()
    begin = f"# xdlc:begin {prefix if prefix != '.' else '/'} (Xora DLC, Local)"
    f = _exclude_file(base)
    lines = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
    if begin in lines:
        a = lines.index(begin)
        b = next((i for i in range(a, len(lines)) if lines[i] == EXCLUDE_END), a)
        lines = lines[:a] + lines[b + 1:]
    if rels:
        pre = "" if prefix == "." else prefix + "/"
        lines += [begin] + ["/" + pre + r for r in sorted(rels)] + [EXCLUDE_END]
    f.parent.mkdir(parents=True, exist_ok=True)
    f.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")


def local_git(base, rels, old, interactive):
    """Local: xdlc files already tracked by git → ask to untrack or keep. → 'untrack' | 'keep' | None."""
    tracked = git_tracked(base, rels)
    if not tracked:
        return None
    if old and old.get("git_tracked") in ("untrack", "keep"):  # choice from a previous setup
        choice = old["git_tracked"]
    elif not interactive:
        return "keep"
    else:
        print("These files are already tracked by git in this repo:")
        for r in tracked:
            print(f"  {r}")
        choice = choose("Local means git does not track xdlc files. Choose:", [
            ("untrack", "Untrack (git rm --cached): files stay on disk; when you commit, they leave the team repo too"),
            ("keep", "Keep as-is: git still tracks them; xdlc changes will show in git status"),
        ])
    if choice == "untrack":
        run(["git", "-C", str(base), "rm", "--cached", "-q", "--", *tracked], check=False)
        print("Untracked from git (not committed). Commit this change if you want them removed from the team repo.")
    return choice


