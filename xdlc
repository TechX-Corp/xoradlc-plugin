def claude_bundle(bundle):
    """Bản plugin trong ~/.xdlc cho Claude Code: MCP server và hook đều gọi xdlc (không cần cat / python3)."""
    dev = bundle / "dev"
    save_json(dev / ".mcp.json", {"mcpServers": {SERVER: mcp_entry()}})
    xdlc = shell_cmd(xdlc_argv())
    hooks = load_json(dev / "hooks" / "hooks.json", {})
    for groups in hooks.get("hooks", {}).values():
        for g in groups:
            for h in g.get("hooks", []):
                c = h.get("command", "")
                if c.startswith("cat "):
                    h["command"] = f"{xdlc} _print {c[4:]}"
                elif "/sensor/convention_sensor.py" in c:
                    h["command"] = f"{xdlc} sensor " + c.split("convention_sensor.py\"", 1)[-1].strip()
    save_json(dev / "hooks" / "hooks.json", hooks)


def setup_claude(bundle, scope, path, old, interactive):
    need_claude()
    git_choice = local_git(path, [CLAUDE_LOCAL], old, interactive) if scope == "local" else None
    claude_bundle(bundle)
    if run(["claude", "plugin", "marketplace", "add", str(bundle)], check=False).returncode != 0:
        run(["claude", "plugin", "marketplace", "update", MARKET])
    r = run(["claude", "plugin", "install", PLUGIN, "--scope", CLAUDE_SCOPE[scope]], cwd=path, check=False)
    if r.returncode != 0 and "already installed" not in (r.stdout + r.stderr):
        raise Abort(f"claude plugin install lỗi:\n{(r.stderr or r.stdout).strip()}")
    if scope == "local" and git_choice != "keep":
        set_exclude(path, [CLAUDE_LOCAL])
    return {"agent": "claude", "scope": scope, "path": str(path), "version": bundle_version(), "git_tracked": git_choice}


