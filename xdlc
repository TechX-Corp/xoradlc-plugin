def config():
    c = load_json(XDLC / "config.json", {})
    return {"env": c.get("env") or "prod", "local_url": c.get("local_url") or LOCAL_URL}


def base_url(c=None):
    c = c or config()
    return (PROD_URL if c["env"] == "prod" else c["local_url"]).rstrip("/")


def request(method, url, *, body=None, form=None, token=None, timeout=30):
    """→ (status, json | text | None). Network error: status 0."""
    headers = {"Accept": "application/json"}
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            status, raw = r.status, r.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        return 0, str(getattr(e, "reason", e))
    if not raw:
        return status, None
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw.decode(errors="replace")


_token_lock = threading.Lock()


def _dpapi(data, protect):
    """Windows DPAPI: only this Windows account can decrypt (CryptProtectData, via ctypes)."""
    import ctypes
    from ctypes import wintypes

    class Blob(ctypes.Structure):
        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]

    buf = ctypes.create_string_buffer(data, len(data))
    src, dst = Blob(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))), Blob()
    crypt32, kernel32 = ctypes.windll.crypt32, ctypes.windll.kernel32
    fn = crypt32.CryptProtectData if protect else crypt32.CryptUnprotectData
    if not fn(ctypes.byref(src), None, None, None, None, 0x1, ctypes.byref(dst)):  # 0x1: no UI prompt
        raise Abort("Could not encrypt / decrypt the token (DPAPI). Run xdlc logout then xdlc login.")
    try:
        return ctypes.string_at(dst.pbData, dst.cbData)
    finally:
        kernel32.LocalFree(dst.pbData)


def _auth():
    raw = load_json(XDLC / "auth.json", {})
    if WINDOWS and "dpapi" in raw:
        return json.loads(_dpapi(base64.b64decode(raw["dpapi"]), protect=False).decode("utf-8"))
    return raw


def tokens(env=None):
    return _auth().get(env or config()["env"])


def save_tokens(env, t):
    auth = _auth()
    if t is None:
        auth.pop(env, None)
    else:
        auth[env] = t
    if WINDOWS:
        auth = {"dpapi": base64.b64encode(_dpapi(json.dumps(auth).encode("utf-8"), protect=True)).decode()}
    save_json(XDLC / "auth.json", auth, private=True)


def _store(env, granted):
    t = {"access_token": granted["access_token"], "refresh_token": granted.get("refresh_token"),
         "expires_at": int(time.time()) + int(granted.get("expires_in") or 3600)}
    save_tokens(env, t)
    return t


def access_token(force_refresh=False):
    """Valid access token for the current backend (auto-refresh), None when logged out / session expired."""
    with _token_lock:
        c = config()
        t = tokens(c["env"])
        if not t:
            return None
        if not force_refresh and t["expires_at"] - 60 > time.time():
            return t["access_token"]
        if not t.get("refresh_token"):
            return None
        status, out = request("POST", base_url(c) + "/oauth/token",
                              form={"grant_type": "refresh_token", "refresh_token": t["refresh_token"],
                                    "client_id": CLIENT_ID})
        if status == 200 and isinstance(out, dict) and out.get("access_token"):
            return _store(c["env"], out)["access_token"]
        if status in (400, 401):  # refresh token expired / account locked: must log in again
            save_tokens(c["env"], None)
        return None


def whoami():
    """→ (account info | None, reason)."""
    token = access_token()
    if not token:
        return None, "not logged in (run xdlc login)"
    status, out = request("GET", base_url() + "/oauth/userinfo", token=token)
    if status == 401:
        token = access_token(force_refresh=True)
        if token:
            status, out = request("GET", base_url() + "/oauth/userinfo", token=token)
    if status == 200 and isinstance(out, dict):
        return out, ""
    if status == 0:
        return None, f"could not connect to {base_url()} ({out})"
    return None, "session expired: run xdlc login" if status == 401 else f"HTTP error {status}"


def account_line(u):
    role = (u.get("role") or "").upper() or "no role"
    return f"{u.get('name')} ({u.get('username')}) · role {role}"


