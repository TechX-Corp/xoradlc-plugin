class Abort(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def err(msg):
    print(msg, file=sys.stderr)


def short(p):
    s = str(p)
    return "~" + s[len(str(HOME)):] if s == str(HOME) or s.startswith(str(HOME) + os.sep) else s


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def save_json(path, data, private=False):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    if private:
        os.chmod(tmp, 0o600)
        os.chmod(path.parent, 0o700)
    os.replace(tmp, path)


def sha256(path):
    return "sha256:" + hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        raise Abort("Cần trả lời trên terminal: chạy lệnh trong một terminal tương tác.", 2)


def confirm(prompt):
    return ask(prompt + " [y/N] ").lower() in ("y", "yes", "c", "co", "có")


def arrow_keys():
    """Menu phím mũi tên khi stdin/stdout là terminal thật trên macOS / Linux; ngoài ra (pipe, CI, Windows,
    XDLC_PLAIN=1) thì gõ số như cũ."""
    if os.name != "posix" or os.environ.get("XDLC_PLAIN") or os.environ.get("TERM") == "dumb":
        return False
    try:
        import termios  # noqa: F401
        import tty  # noqa: F401
    except ImportError:
        return False
    return sys.stdin.isatty() and sys.stdout.isatty()


def _key(fd):
    b = os.read(fd, 1)
    if b == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        return {b"[A": "up", b"[B": "down", b"OA": "up", b"OB": "down"}.get(os.read(fd, 2), "")
    return {b"\r": "enter", b"\n": "enter", b" ": "space", b"k": "up", b"j": "down",
            b"a": "all", b"q": "esc", b"\x04": "esc"}.get(b, "")


def menu(title, labels, multi=False):
    """↑/↓ di chuyển, Enter chọn; multi: Space đánh dấu, a = tất cả. Esc / q huỷ. → chỉ số đã chọn."""
    import termios
    import tty
    fd, n = sys.stdin.fileno(), len(labels)
    cols = shutil.get_terminal_size((80, 24)).columns
    width = cols - 1 if cols >= 40 else 10_000  # không biết độ rộng thì không cắt dòng
    tips = ("↑/↓ di chuyển · Space chọn · a chọn tất cả · Enter xác nhận · Esc huỷ" if multi
            else "↑/↓ di chuyển · Enter chọn · Esc huỷ")
    cur, marked, hint, result = 0, set(), None, None
    out = sys.stdout

    def draw(first=False):
        if not first:
            out.write(f"\x1b[{n + 1}A")
        for i, text in enumerate(labels):
            box = ("[x] " if i in marked else "[ ] ") if multi else ""
            out.write("\r\x1b[2K" + f"{'>' if i == cur else ' '} {box}{text}"[:width] + "\n")
        out.write("\r\x1b[2K" + (hint or tips)[:width] + "\n")
        out.flush()

    print(title)
    old = termios.tcgetattr(fd)
    out.write("\x1b[?25l")
    try:
        tty.setcbreak(fd, termios.TCSANOW)  # TCSANOW: không bỏ phím đã gõ sẵn
        draw(first=True)
        while result is None:
            k, hint = _key(fd), None
            if k == "up":
                cur = (cur - 1) % n
            elif k == "down":
                cur = (cur + 1) % n
            elif k == "space" and multi:
                marked ^= {cur}
            elif k == "all" and multi:
                marked = set() if len(marked) == n else set(range(n))
            elif k == "enter":
                if not multi:
                    result = [cur]
                elif marked:
                    result = sorted(marked)
                else:
                    hint = "Chưa chọn mục nào: Space để chọn, Esc để huỷ"
            elif k == "esc":
                raise Abort("Đã huỷ.", 0)
            if result is None:
                draw()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        out.write(f"\x1b[{n + 1}A\x1b[J\x1b[?25h")  # xoá menu, hiện lại con trỏ
        out.flush()
    for i in result:
        print(f"  › {labels[i]}")
    return result


def choose(title, options):
    """options: [(key, label)] → key. Phím mũi tên trên terminal; ngoài ra gõ số đến khi hợp lệ."""
    if arrow_keys():
        return options[menu(title, [lab for _, lab in options])[0]][0]
    print(title)
    for i, (_, label) in enumerate(options, 1):
        print(f"  {i}) {label}")
    while True:
        a = ask("> ")
        if a.isdigit() and 1 <= int(a) <= len(options):
            return options[int(a) - 1][0]
        print(f"Nhập một số từ 1 đến {len(options)}.")


def pick_many(n, answer):
    """'1,3' | '1-2' | 'all' → các chỉ số 0-based, None nếu không hợp lệ."""
    if answer.lower() in ("all", "tất cả"):
        return list(range(n))
    out = []
    for part in answer.replace(" ", "").split(","):
        lo, _, hi = part.partition("-")
        if not lo.isdigit() or (hi and not hi.isdigit()):
            return None
        a, b = int(lo), int(hi or lo)
        if not 1 <= a <= b <= n:
            return None
        out += [i - 1 for i in range(a, b + 1) if i - 1 not in out]
    return out or None


def run(cmd, cwd=None, check=True):
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and r.returncode != 0:
        raise Abort(f"Lệnh lỗi: {' '.join(cmd)}\n{(r.stderr or r.stdout).strip()}")
    return r


