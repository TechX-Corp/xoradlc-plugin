class _Callback(http.server.BaseHTTPRequestHandler):
    result = {}

    def log_message(self, *a):
        pass

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        if u.path != "/oauth/callback":
            self.send_response(404)
            self.end_headers()
            return
        _Callback.result.update({k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()})
        success = "code" in _Callback.result
        detail = _Callback.result.get("error_description") or _Callback.result.get("error") or ""
        data = _oauth_callback_page(success, detail)
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def cmd_login(argv):
    if argv:
        raise Abort("login takes no options.", 2)
    base = base_url()
    status, meta = request("GET", base + "/.well-known/oauth-authorization-server")
    if status != 200 or not isinstance(meta, dict):
        raise Abort(f"Could not load login metadata from {base} ({meta if status == 0 else 'HTTP ' + str(status)}).")
    verifier = secrets.token_urlsafe(48)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    state = secrets.token_urlsafe(16)
    _Callback.result = {}
    srv = http.server.HTTPServer(("127.0.0.1", 0), _Callback)
    redirect = f"http://127.0.0.1:{srv.server_port}/oauth/callback"
    url = meta["authorization_endpoint"] + "?" + urllib.parse.urlencode({
        "response_type": "code", "client_id": CLIENT_ID, "redirect_uri": redirect,
        "code_challenge": challenge, "code_challenge_method": "S256", "state": state})
    print(f"Sign in to {em('Xora DLC')}. "
          f"Open this page if the browser does not open:\n{url}", flush=True)
    if not os.environ.get("XDLC_NO_BROWSER"):
        webbrowser.open(url)
    srv.timeout = 1
    deadline = time.time() + 300
    while not _Callback.result and time.time() < deadline:
        srv.handle_request()
    srv.server_close()
    res = _Callback.result
    if not res:
        raise Abort("Timed out after 5 minutes without completing sign-in. Run xdlc login again.")
    if res.get("state") != state:
        raise Abort("Login response state mismatch. Run xdlc login again.")
    if "code" not in res:
        raise Abort(f"Sign-in failed: {res.get('error_description') or res.get('error')}")
    status, out = request("POST", meta["token_endpoint"], form={
        "grant_type": "authorization_code", "code": res["code"], "redirect_uri": redirect,
        "client_id": CLIENT_ID, "code_verifier": verifier})
    if status != 200 or not isinstance(out, dict) or not out.get("access_token"):
        raise Abort(f"Token exchange failed: {out}")
    _store(out)
    u, why = whoami()
    print(f"{ok('Signed in:')} " + (account_line(u) if u else f"(could not read account: {why})"))
    if u and not u.get("role"):
        print(warn("Account has no role:") + dim(f" ask a {em('Xora DLC')} admin to assign a role "
                                                 f"(e.g. {em('DEV')}) before asking the agent."))
    print(dim(f"Wrong account? Sign out of {em('Xora DLC')} in the browser, run {em('xdlc logout')}, "
              f"then {em('xdlc login')}."))


