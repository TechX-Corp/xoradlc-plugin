def cmd_use(argv):
    argv = long_opts(argv)
    c = config()

    def using_line(cfg):
        if cfg["env"] == "local":
            return f"{bold('Using:')} {em(cfg['env'])}  {dim(base_url(cfg))}"
        return f"{bold('Using:')} {em(cfg['env'])}"

    if not argv:
        print(using_line(c))
        print(dim("Switch: ") + em("xdlc use prod") + dim(" | ") + em("xdlc use local")
              + dim(" [") + em("-u") + dim(", ") + em("--url URL") + dim("]"))
        return
    env, rest = argv[0], argv[1:]
    if env not in ("prod", "local"):
        raise Abort("xdlc use prod | xdlc use local [-u, --url URL]", 2)
    if rest:
        if env != "local" or len(rest) != 2 or rest[0] != "--url" or not rest[1].startswith(("http://", "https://")):
            raise Abort("-u / --url is only for local, e.g. xdlc use local -u http://localhost:9000", 2)
        c["local_url"] = rest[1].rstrip("/")
    changed = env != c["env"] or bool(rest)
    c["env"] = env
    save_json(XDLC / "config.json", c)
    print(using_line(c))
    if not tokens(env):
        print(dim("Not logged in to this backend: run ") + em("xdlc login") + dim("."))
    if changed:
        print(dim("Open a new agent session (or reconnect ") + em("xora-dev")
              + dim(" in ") + em("/mcp") + dim(") so the agent uses the new backend."))


def reapply(items, interactive):
    bundle = BUNDLE / "agents-plugin"
    done = []
    for r in items:
        if r["scope"] != "global" and not Path(r["path"]).is_dir():
            print(dim(f"  Skipping {label(r).strip()}: directory no longer exists."))
            done.append(r)
            continue
        try:
            done.append(SETUP[r["agent"]](bundle, r["scope"], r["path"], r, interactive))
            if r["scope"] == "local" and (root := git_root(r["path"])) and pre_push_of(root):
                install_pre_push(root)  # refresh hook command for the new version
            print(f"  {ok('Updated')} {label(r).strip()}")
        except Abort as e:
            print(f"  {warn('Error')} updating {label(r).strip()}: {e}")
            done.append(r)
    save_installs(done)


def cmd_update(argv):
    if argv:
        raise Abort("update takes no options.", 2)
    ref = os.environ.get("XDLC_REF")
    if not ref and not os.environ.get("XDLC_PLUGIN_DIR"):
        ref = latest_release()
        if not ref:
            # Temporary until the first vX.Y.Z release exists: pull tip of main.
            ref = "main"
            print(dim("No release tag yet; updating from ") + em("main") + dim("."))
        elif _semver(ref) <= _semver(VERSION) and bundle_version() == VERSION:
            print(ok("Already up to date") + dim(f" ({VERSION})."))
            return
    src = fetch_bundle(ref)
    new_cli = src / "xdlc"
    if not new_cli.is_file():
        raise Abort("Downloaded package has no xdlc.")
    target = xdlc_path()
    tmp = target.with_name(target.name + ".new")
    shutil.copyfile(new_cli, tmp)
    os.chmod(tmp, 0o755)
    install_bundle(src)
    os.replace(tmp, target)
    src_label = em(ref) if ref else dim("local copy")
    print(f"{ok('Updated')} {em('xdlc')} and plugin ({src_label}).")
    print(dim("Reinstalling into existing setups:"))
    # New binary reinstalls itself so install logic is from the new version.
    if WINDOWS:
        raise Abort("", subprocess.run([sys.executable, str(target), "_reapply"]).returncode)
    os.execv(sys.executable, [sys.executable, str(target), "_reapply"])


