def cmd_link(argv):
    argv = long_opts(argv)
    wo = step_id = branch = None
    list_only, i = False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--list":
            list_only = True
        elif a in ("--step", "--branch") and i + 1 < len(argv):
            step_id, branch = (argv[i + 1], branch) if a == "--step" else (step_id, argv[i + 1])
            i += 1
        elif not a.startswith("-") and wo is None:
            wo = a
        else:
            raise Abort("xdlc link [WO-…] [-t, --step STEP] [-b, --branch BRANCH] [-l, --list]", 2)
        i += 1
    root = git_root(Path.cwd())
    if not root:
        raise Abort("Not a git repo: cd into the repo and run again.")
    branch = branch or git_out(root, "branch", "--show-current")
    if not branch:
        raise Abort("Not on a branch (detached HEAD): add --branch <name>.")
    repo_id, _ = repo_identity(root)
    cur = link_of(repo_id, branch)
    steps = my_steps()
    if list_only:
        mapped = step_label(cur) if cur else dim("no work order mapped")
        print(f"{bold('Branch')} {em(branch)} ({em(repo_id)}): {mapped}")
        print()
        if steps:
            print(dim("Your in-progress steps (") + em("xdlc link <WO>") + dim(" ")
                  + em("--step") + dim(" <step>):"))
            for i, st in enumerate(steps, 1):
                meta = f"{st.get('work_order_name') or ''} · {st.get('step_name') or ''}".strip(" ·")
                print(f"  {i}. {em(st['work_order_id'])} {em('--step')} {em(st['step_id'])}"
                      + (f"   {meta}" if meta else ""))
        else:
            print(dim("You have no in-progress steps."))
        return
    if wo:
        cands = [st for st in steps if st["work_order_id"].lower() == wo.lower() and (not step_id or st["step_id"] == step_id)]
        if not cands:
            raise Abort(f"{wo}{' / ' + step_id if step_id else ''} is not among your in-progress steps. See: xdlc link --list")
        if len(cands) > 1:
            raise Abort(f"{wo} has multiple in-progress steps; add --step: " + " | ".join(st["step_id"] for st in cands))
        chosen = cands[0]
    else:
        if not steps:
            raise Abort(f"You have no in-progress steps in Xora DLC ({config()['env']}): nothing to map.")
        chosen = pick_step(branch, steps)
    save_link(repo_id, branch, chosen)
    was = ""
    if cur and (cur["work_order_id"], cur["step_id"]) != (chosen["work_order_id"], chosen["step_id"]):
        was = dim(f" (was: {cur['work_order_id']})")
    print(f"{ok('Mapped')} branch {em(branch)} → {em(step_label(chosen))}{was}")
    if not pre_push_of(root) and install_pre_push(root):
        print(ok("Installed") + dim(" git pre-push hook for this repo: on push, the sensor sends alerts "
                                    "for the work order above."))


