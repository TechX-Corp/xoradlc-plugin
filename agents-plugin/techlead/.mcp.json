{
  "mcpServers": {
    "xora-techlead": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/xora_mcp.py"
      ],
      "env": {
        "XORA_ROLE": "techlead",
        "XORA_BASE_URL": "${XORA_BASE_URL}",
        "XORA_API_KEY": "${XORA_API_KEY}",
        "XORA_USER_ID": "${XORA_USER_ID}",
        "XORA_AGENT": "${XORA_AGENT:-developer}",
        "XORA_DLC_URL": "${XORA_DLC_URL}",
        "XORA_DLC_REFRESH_TOKEN": "${XORA_DLC_REFRESH_TOKEN}"
      }
    }
  }
}
