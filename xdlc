SHORT = {"-a": "--agent", "-s": "--scope", "-t": "--step", "-b": "--branch", "-l": "--list", "-u": "--url"}


def long_opts(argv):
    """-a kiro → --agent kiro (short options, like -v / --version)."""
    return [SHORT.get(a, a) for a in argv]


def options(argv, allowed):
    """-a, --agent kiro|claude; -s, --scope global|local (also --x=y form) → dict."""
    vals = {"agent": AGENTS, "scope": SCOPES}
    argv = long_opts(argv)
    out, i = {}, 0
    while i < len(argv):
        k, eq, v = argv[i].partition("=")
        name = k[2:] if k.startswith("--") else None
        if name not in allowed:
            raise Abort("Options: " + "  ".join(f"-{n[0]}, --{n} {'|'.join(vals[n])}" for n in allowed), 2)
        if not eq:
            i += 1
            v = argv[i] if i < len(argv) else ""
        if v not in vals[name]:
            raise Abort(f"--{name} must be {' or '.join(vals[name])}.", 2)
        out[name] = v
        i += 1
    return out


def cmd_setup(argv):
    opt = options(argv, ("agent", "scope"))
    agent = opt.get("agent") or choose("Install for which agent?", [(k, v) for k, v in AGENTS.items()])
    if agent == "claude":
        need_claude()
    elif not shutil.which("kiro-cli"):
        print(warn("Note:") + dim(f" command 'kiro-cli' not found on this machine; installing anyway — "
                                   f"{em('Kiro')} will use it once {em('Kiro CLI')} is installed."))
    cwd = Path.cwd()
    scope = opt.get("scope") or choose(f"Where to install for {AGENTS[agent]}?", [
        ("global", "Global  every repo on this machine"),
        ("local", f"Local   current project ({short(cwd)}); git does not track xdlc files"),
    ])
    path = HOME if scope == "global" else cwd
    if scope == "local" and cwd == HOME:
        if not confirm(f"Current directory is your home ({short(cwd)}), not a project. Install anyway?"):
            raise Abort("Cancelled. cd into a project directory and run again.", 0)
    rec_new = {"agent": agent, "scope": scope, "path": str(path)}
    items = installs()
    old = next((r for r in items if same(r, rec_new)), None)
    bundle = ensure_bundle()
    rec = SETUP[agent](bundle, scope, path, old, True)
    items = [r for r in items if not same(r, rec)] + [rec]
    save_installs(items)
    verb = "Reinstalled" if old else "Installed"
    print()
    print(f"{ok(verb)} {em('xora-dev')} for {em(AGENTS[agent])}: {label(rec).strip()}")
    if any(r["agent"] == agent and r["scope"] == "global" for r in items) and \
            any(r["agent"] == agent and r["scope"] == "local" and r["path"] == str(cwd) for r in items):
        print(warn("Note:") + dim(f" both Global and Local exist for this project; "
                                  f"{em('Local')} is used, Global is redundant here."))
    root = git_root(path) if scope == "local" else None
    if root and install_pre_push(root):
        print(ok("Installed") + dim(f" git pre-push hook: on push, the sensor sends alerts to {em('Xora DLC')} "
                                    f"(first push per branch asks for a work order)."))
    elif scope == "global":
        print(dim(f"To send convention alerts to {em('Xora DLC')} on push: in each repo "
                  f"(without Local setup) run {em('xdlc link')}."))
    tip = "open a new Kiro session" if agent == "kiro" else "open a new Claude Code session (accept the xora-dev MCP server if asked)"
    print()
    print(dim(f"Next: {tip}." + ("" if tokens() else f" Not logged in: run {em('xdlc login')}.")))


def cmd_remove(argv):
    agent = options(argv, ("agent",)).get("agent")
    items = installs()
    cands = [r for r in items if not agent or r["agent"] == agent]
    if not cands:
        raise Abort(f"No {AGENTS[agent] if agent else 'xora-dev'} setup found.", 0)
    cwd = str(Path.cwd())
    if len(cands) == 1:
        chosen = cands
        if not confirm(f"Remove {label(cands[0]).strip()}?"):
            raise Abort("Cancelled.", 0)
    else:
        labels = [label(r) + ("   ← current directory" if r["scope"] != "global" and r["path"] == cwd else "")
                  for r in cands]
        if arrow_keys():
            idx = menu("Select setups to remove:", labels, multi=True)
        else:
            print("Select setups to remove (e.g. 1,3 | 1-2 | all):")
            for i, text in enumerate(labels, 1):
                print(f"  {i}) {text}")
            while (idx := pick_many(len(cands), ask("> "))) is None:
                print("Enter numbers, a range, or all.")
        chosen = [cands[i] for i in idx]
        print()
        print(f"{bold('Will remove:')}")
        for r in chosen:
            what = (f"{len(r.get('files', {}))} file(s) under .kiro/, {em(SERVER)} block in {r['mcp_json']}"
                    if r["agent"] == "kiro" else f"plugin {em(SERVER)} (scope {em(CLAUDE_SCOPE[r['scope']])})")
            print(f"  - {label(r).strip()}: {what}")
        if not confirm("Continue?"):
            raise Abort("Cancelled.", 0)
    print()
    for r in chosen:
        REMOVE[r["agent"]](r, True)
        items = [x for x in items if not same(x, r)]
        save_installs(items)
        print(f"{ok('Removed')} {label(r).strip()}")
        root = git_root(r["path"]) if r["scope"] == "local" and Path(r["path"]).is_dir() else None
        if root and (hook := pre_push_of(root)):
            if pre_push_still_needed(root, items):
                print(dim("  Keeping pre-push hook: repo still has a branch mapped to a work order "
                          f"({em('xdlc link')})."))
            else:
                remove_pre_push(hook)
                print(dim("  Removed pre-push hook."))
    after_claude_removed(items)
    if not items:
        shutil.rmtree(BUNDLE, ignore_errors=True)


