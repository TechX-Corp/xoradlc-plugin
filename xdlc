def long_opts(argv):
    """-a kiro → --agent kiro (tuỳ chọn ngắn, như -v / --version)."""
    return [SHORT.get(a, a) for a in argv]


def options(argv, allowed):
    """-a, --agent kiro|claude; -s, --scope global|local (cả dạng --x=y) → dict."""
    vals = {"agent": AGENTS, "scope": SCOPES}
    argv = long_opts(argv)
    out, i = {}, 0
    while i < len(argv):
        k, eq, v = argv[i].partition("=")
        name = k[2:] if k.startswith("--") else None
        if name not in allowed:
            raise Abort("Tuỳ chọn: " + "  ".join(f"-{n[0]}, --{n} {'|'.join(vals[n])}" for n in allowed), 2)
        if not eq:
            i += 1
            v = argv[i] if i < len(argv) else ""
        if v not in vals[name]:
            raise Abort(f"--{name} phải là {' hoặc '.join(vals[name])}.", 2)
        out[name] = v
        i += 1
    return out


