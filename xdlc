class Abort(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def err(msg):
    print(msg, file=sys.stderr)


def short(p):
    s = str(p)
    return "~" + s[len(str(HOME)):] if s == str(HOME) or s.startswith(str(HOME) + os.sep) else s


def print_table(headers, rows, indent="  "):
    """Print a bordered table (columns / rows / cells). ASCII when XDLC_PLAIN or dumb TERM."""
    cols = list(headers)
    data = [list(r) for r in rows]
    widths = [len(h) for h in cols]
    for row in data:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell))
    plain = bool(os.environ.get("XDLC_PLAIN") or os.environ.get("TERM") == "dumb")
    if plain:
        h, v, x = "-", "|", "+"
        tl, tr, bl, br = x, x, x, x
        l, r, t, b = x, x, x, x
    else:
        h, v = "─", "│"
        tl, tr, bl, br = "┌", "┐", "└", "┘"
        l, r, t, b, x = "├", "┤", "┬", "┴", "┼"

    def line(left, mid, right, fill=h):
        return indent + left + mid.join(fill * (w + 2) for w in widths) + right

    def row_line(cells):
        body = v.join(f" {c:<{widths[i]}} " for i, c in enumerate(cells))
        return f"{indent}{v}{body}{v}"

    print(line(tl, t, tr))
    print(row_line(cols))
    print(line(l, x, r))
    for row in data:
        print(row_line(row))
    print(line(bl, b, br))


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def save_json(path, data, private=False):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    if private:
        os.chmod(tmp, 0o600)
        os.chmod(path.parent, 0o700)
    os.replace(tmp, path)


def sha256(path):
    return "sha256:" + hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        raise Abort("Need a terminal answer: run the command in an interactive terminal.", 2)


def confirm(prompt):
    """Yes/No menu (↑/↓ + Enter); default No — like old [y/N]. Plain: type a number."""
    return choose(prompt, [("no", "No"), ("yes", "Yes")]) == "yes"


def _enable_vt():
    """Windows: enable ANSI control codes for the console (Windows Terminal already on; old conhost may not)."""
    try:
        import ctypes
        k = ctypes.windll.kernel32
        h, mode = k.GetStdHandle(-11), ctypes.c_uint32()
        return bool(k.GetConsoleMode(h, ctypes.byref(mode)) and k.SetConsoleMode(h, mode.value | 0x0004))
    except (AttributeError, OSError):
        return False


_COLOR = None  # cached: None unknown, True/False after first probe


def color_enabled():
    """ANSI colors when stdout is a TTY; off for pipe/CI, NO_COLOR, XDLC_PLAIN, TERM=dumb."""
    global _COLOR
    if _COLOR is not None:
        return _COLOR
    if os.environ.get("NO_COLOR") or os.environ.get("XDLC_PLAIN") or os.environ.get("TERM") == "dumb":
        _COLOR = False
    elif not sys.stdout.isatty():
        _COLOR = False
    elif WINDOWS:
        _COLOR = _enable_vt()
    else:
        _COLOR = True
    return _COLOR


def _paint(text, *codes):
    if not text or not color_enabled():
        return text
    return f"\x1b[{';'.join(str(c) for c in codes)}m{text}\x1b[0m"


def bold(text):
    return _paint(text, 1)


def dim(text):
    return _paint(text, 2)


def focus(text):
    """Focused menu label: bold cyan."""
    return _paint(text, 1, 36)


def em(text):
    """Proper nouns / jargon accent: cyan."""
    return _paint(text, 36)


def ok(text):
    return _paint(text, 32)


def warn(text):
    return _paint(text, 33)


def print_help(text, file=None):
    """Paint help blocks like other TUI: bold sections, accent names, dim trailing tips."""
    out = file or sys.stdout

    def put(s=""):
        print(s, file=out)

    lines = text.rstrip().splitlines()
    for i, line in enumerate(lines):
        if not line:
            put()
            continue
        if i == 0 and line.startswith("xdlc "):
            body = line[5:]
            for name in ("Xora DLC", "Claude Code", "Kiro CLI", "xora-dlc"):
                body = body.replace(name, em(name))
            put(f"{bold('xdlc')} {body}")
            continue
        if line in ("Commands:", "Options:", "Shortcuts (skip terminal prompts):"):
            put(bold(line))
            continue
        if line.startswith("Usage:"):
            put(f"{bold('Usage:')}{line[6:]}")
            continue
        if line.startswith("Scope:"):
            put(f"{bold('Scope:')}{dim(line[6:])}")
            continue
        if line.startswith("For details"):
            put(dim(line))
            continue
        m = re.match(r"^(  )(\S.*?\S|\S)( {2,})(.+)$", line)
        if m:
            put(f"{m.group(1)}{em(m.group(2))}{m.group(3)}{m.group(4)}")
            continue
        put(line)


def arrow_keys():
    """Arrow-key menus when stdin/stdout are a real terminal; otherwise (pipe, CI, ANSI-unaware console,
    XDLC_PLAIN=1) type numbers."""
    if os.environ.get("XDLC_PLAIN") or os.environ.get("TERM") == "dumb":
        return False
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        if WINDOWS:
            import msvcrt  # noqa: F401
            return _enable_vt()
        import termios  # noqa: F401
        import tty  # noqa: F401
    except ImportError:
        return False
    return True


WIN_KEYS = {"H": "up", "P": "down"}
KEYS = {"\r": "enter", "\n": "enter", " ": "space", "k": "up", "j": "down", "a": "all", "q": "esc",
        "\x04": "esc", "\x1b": "esc"}


def _key(fd):
    if WINDOWS:
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):  # special keys: arrows = \xe0 + H/P
            return WIN_KEYS.get(msvcrt.getwch(), "")
        if ch == "\x03":
            raise KeyboardInterrupt
        return KEYS.get(ch, "")
    b = os.read(fd, 1)
    if b == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        return {b"[A": "up", b"[B": "down", b"OA": "up", b"OB": "down"}.get(os.read(fd, 2), "")
    return KEYS.get(b.decode(errors="ignore"), "")


class _Raw:
    """POSIX: read one key at a time (cbreak); Windows: msvcrt already reads per key, nothing else needed."""

    def __enter__(self):
        if not WINDOWS:
            import termios
            import tty
            self.fd = sys.stdin.fileno()
            self.old = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd, termios.TCSANOW)  # TCSANOW: do not drop keys already typed
        return self

    def __exit__(self, *exc):
        if not WINDOWS:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)


def _tip_action(key, gloss):
    """Menu footer: accent the key, dim the gloss (e.g. Enter + select)."""
    return f"{em(key)}{dim(' ' + gloss)}"


def menu_tips(multi=False):
    sep = dim(" · ")
    if multi:
        return sep.join((
            _tip_action("↑/↓", "move"),
            _tip_action("Space", "select"),
            _tip_action("a", "select all"),
            _tip_action("Enter", "confirm"),
            _tip_action("Esc", "cancel"),
        ))
    return sep.join((
        _tip_action("↑/↓", "move"),
        _tip_action("Enter", "select"),
        _tip_action("Esc", "cancel"),
    ))


def menu(title, labels, multi=False):
    """↑/↓ move, Enter select; multi: Space mark, a = all. Esc / q cancel. → selected indices.
    Single: ◉/○ radio; multi: > focus + □/▣. Focused label is cyan."""
    fd, n = sys.stdin.fileno(), len(labels)
    cols = shutil.get_terminal_size((80, 24)).columns
    width = cols - 1 if cols >= 40 else 10_000  # unknown width: do not truncate lines
    tips = menu_tips(multi)
    cur, marked, hint, result = 0, set(), None, None
    out = sys.stdout

    def draw(first=False):
        if not first:
            out.write(f"\x1b[{n + 1}A")
        for i, text in enumerate(labels):
            if multi:
                box = "▣ " if i in marked else "□ "
                prefix = f"{'>' if i == cur else ' '} {box}"
            else:
                prefix = "◉ " if i == cur else "○ "
            room = max(0, width - len(prefix))
            label = text if len(text) <= room else text[:room]
            line = prefix + label
            if i == cur:
                line = focus(line)  # radio / arrow+checkbox + label
            out.write("\r\x1b[2K" + line + "\n")
        out.write("\r\x1b[2K" + (hint or tips) + "\n")
        out.flush()

    print(title)
    out.write("\x1b[?25l")
    raw = _Raw().__enter__()
    try:
        draw(first=True)
        while result is None:
            k, hint = _key(fd), None
            if k == "up":
                cur = (cur - 1) % n
            elif k == "down":
                cur = (cur + 1) % n
            elif k == "space" and multi:
                marked ^= {cur}
            elif k == "all" and multi:
                marked = set() if len(marked) == n else set(range(n))
            elif k == "enter":
                if not multi:
                    result = [cur]
                elif marked:
                    result = sorted(marked)
                else:
                    hint = (dim("Nothing selected: ") + em("Space") + dim(" to select, ")
                            + em("Esc") + dim(" to cancel"))
            elif k == "esc":
                raise Abort("Cancelled.", 0)
            if result is None:
                draw()
    finally:
        raw.__exit__()
        out.write(f"\x1b[{n + 1}A\x1b[J\x1b[?25h")  # clear menu, show cursor again
        out.flush()
    for i in result:
        print(f"  › {bold(labels[i])}")
    return result


def choose(title, options):
    """options: [(key, label)] → key. Arrow keys on a terminal; otherwise type a number until valid."""
    if arrow_keys():
        return options[menu(title, [lab for _, lab in options])[0]][0]
    print(title)
    for i, (_, label) in enumerate(options, 1):
        print(f"  {i}) {label}")
    while True:
        a = ask("> ")
        if a.isdigit() and 1 <= int(a) <= len(options):
            return options[int(a) - 1][0]
        print(f"Enter a number from 1 to {len(options)}.")


def pick_many(n, answer):
    """'1,3' | '1-2' | 'all' → 0-based indices, None if invalid."""
    if answer.lower() == "all":
        return list(range(n))
    out = []
    for part in answer.replace(" ", "").split(","):
        lo, _, hi = part.partition("-")
        if not lo.isdigit() or (hi and not hi.isdigit()):
            return None
        a, b = int(lo), int(hi or lo)
        if not 1 <= a <= b <= n:
            return None
        out += [i - 1 for i in range(a, b + 1) if i - 1 not in out]
    return out or None


def run(cmd, cwd=None, check=True):
    exe = shutil.which(cmd[0])  # Windows: claude is claude.cmd; must call via full path
    cmd = [exe or cmd[0], *cmd[1:]]
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if check and r.returncode != 0:
        raise Abort(f"Command failed: {' '.join(cmd)}\n{(r.stderr or r.stdout).strip()}")
    return r


def xdlc_path():
    """Path the agent uses to run `xdlc mcp`: installed copy, else this running file."""
    return BIN if BIN.is_file() else Path(os.path.abspath(sys.argv[0]))


def xdlc_argv():
    """Command to run xdlc for the agent / hook. Windows cannot run a .py file directly: use py -3 (stable across
    Python upgrades), else the current Python."""
    if not WINDOWS:
        return [str(xdlc_path())]
    py = shutil.which("py")
    return ([py, "-3"] if py else [sys.executable]) + [str(xdlc_path())]


def shell_cmd(argv):
    """One shell command line (bash, sh, cmd all understand): quote each part, paths use /."""
    return " ".join('"' + a.replace("\\", "/") + '"' if (" " in a or "\\" in a or "/" in a) else a for a in argv)


