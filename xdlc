    hook_doc = json.loads(tmpl.read_text(encoding="utf-8")) if tmpl.is_file() else {"hooks": {}}
    cmd = shell_cmd(xdlc_argv() + ["_print", str(agents_md), str(guidance_md)])
    for groups in (hook_doc.get("hooks") or {}).values():
        for g in groups:
            for h in g.get("hooks", []):
                if "command" in h:
                    h["command"] = cmd
    settings = load_json(settings_path, {})
    if not isinstance(settings, dict):
        settings = {}
    # replace our SessionStart group; keep other hooks keys
    hooks = settings.setdefault("hooks", {})
    hooks["SessionStart"] = (hook_doc.get("hooks") or {}).get("SessionStart") or []
    save_json(settings_path, settings)


def setup_kiro(bundle, scope, path, old, interactive, role_id, agents_src, skills):
    man = host_manifest("kiro", bundle)
    base = Path(path)
    mcp_rel = man["mcp"]["config_path"]
    agents_rel = man["artifacts"]["agents_md"]
    skills_rel = man["artifacts"]["skills_dir"]
    plan_rels = [agents_rel, mcp_rel] + [it["dest"] for it in (man.get("standards") or []) if it.get("dest")]
    git_choice = local_git(base, plan_rels, old, interactive) if scope == "local" else None
    files = {}
    files[agents_rel] = copy_tracked(agents_src, base / agents_rel)
    install_standards(man, bundle, base, files)
    # skills under skills_dir/<name>/SKILL.md
    skill_files = {}
    skills_root = base / skills_rel
    for sk in skills:
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", sk["name"]).strip("-") or "skill"
        rel = f"{skills_rel}/{safe}/SKILL.md"
        dst = base / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(skill_md(sk["name"], sk["description"]), encoding="utf-8")
        files[rel] = sha256(dst)
        skill_files[rel] = files[rel]
    for rel, digest in (old or {}).get("files", {}).items():
        if rel not in files:
            remove_file(base, rel, digest, interactive)
    mcp_file = base / mcp_rel
    created = (old or {}).get("created_mcp_json", not mcp_file.exists())
    write_mcp_config(mcp_file, mcp_entry())
    rec = {"agent": "kiro", "scope": scope, "path": str(base), "version": VERSION, "role": role_id,
           "files": files, "mcp_json": mcp_rel, "created_mcp_json": created, "git_tracked": git_choice}
    if scope == "local":
        excluded = [r for r in files if git_choice != "keep" or r not in git_tracked(base, [r])]
        if created or git_choice == "untrack":
            excluded.append(mcp_rel)
        set_exclude(base, excluded)
    return rec


def remove_kiro(rec, interactive):
    base = Path(rec["path"])
    for rel, digest in rec.get("files", {}).items():
        remove_file(base, rel, digest, interactive)
    mcp_rel = rec.get("mcp_json") or ".kiro/settings/mcp.json"
    strip_mcp_config(base / mcp_rel, rec.get("created_mcp_json"))
    if rec["scope"] == "local":
        set_exclude(base, [])
    kiro = base / ".kiro"
    if kiro.is_dir() and base != HOME:
        for d in sorted((p for p in kiro.rglob("*") if p.is_dir()), reverse=True):
            if not any(d.iterdir()):
                d.rmdir()
        if kiro.is_dir() and not any(kiro.iterdir()):
            kiro.rmdir()


def setup_claude(bundle, scope, path, old, interactive, role_id, agents_src, skills):
    if not shutil.which("claude"):
        raise Abort("Command 'claude' not found. Install Claude Code first: https://code.claude.com")
    man = host_manifest("claude", bundle)
    base = Path(path) if scope == "local" else HOME
    art = man["artifacts"]
    mcp_rel = man["mcp"]["config_path_local"] if scope == "local" else man["mcp"]["config_path_global"]
    if scope == "global":
        mcp_path = HOME / mcp_rel.lstrip("./")
        # ~/.claude.json lives in home
        if mcp_rel == ".claude.json":
            mcp_path = HOME / ".claude.json"
    else:
        mcp_path = base / mcp_rel
    agents_rel = art["agents_md"]
    skills_rel = art["skills_dir"]
    settings_rel = art["settings_local"] if scope == "local" else art["settings_global"]
    git_choice = local_git(base, [settings_rel, mcp_rel, agents_rel], old, interactive) if scope == "local" else None
    files = {}
    agents_dst = base / agents_rel
    files[agents_rel] = copy_tracked(agents_src, agents_dst)
    install_standards(man, bundle, base, files)
    for sk in skills:
        safe = re.sub(r"[^A-Za-z0-9._-]+", "-", sk["name"]).strip("-") or "skill"
        rel = f"{skills_rel}/{safe}/SKILL.md"
        dst = base / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.write_text(skill_md(sk["name"], sk["description"]), encoding="utf-8")
        files[rel] = sha256(dst)
    guidance_rel = next((it["dest"] for it in (man.get("standards") or []) if it.get("source") == "GUIDANCE.md"), None)
    guidance_path = base / guidance_rel if guidance_rel else agents_dst
    settings_path = base / settings_rel
    merge_claude_hooks(settings_path, agents_dst, guidance_path if Path(guidance_path).is_file() else agents_dst)
    files[settings_rel] = sha256(settings_path)
    created = (old or {}).get("created_mcp_json", not mcp_path.exists())
    write_mcp_config(mcp_path, mcp_entry())
    # track mcp path relative when under base
    try:
        mcp_track = str(mcp_path.relative_to(base))
    except ValueError:
        mcp_track = str(mcp_path)
    files[mcp_track] = sha256(mcp_path)
    for rel, digest in (old or {}).get("files", {}).items():
        if rel not in files:
            remove_file(base, rel, digest, interactive)
    if scope == "local" and git_choice != "keep":
        set_exclude(base, [settings_rel, mcp_rel])
    return {"agent": "claude", "scope": scope, "path": str(base), "version": VERSION, "role": role_id,
            "files": files, "mcp_json": mcp_track, "created_mcp_json": created, "git_tracked": git_choice,
            "settings_rel": settings_rel}


def remove_claude(rec, interactive):
    base = Path(rec["path"])
    for rel, digest in rec.get("files", {}).items():
        p = Path(rel) if Path(rel).is_absolute() else base / rel
        if p.is_file():
            if sha256(p) != digest and not (interactive and confirm(f"  {short(p)} was modified after install. Delete anyway?")):
                print(f"  Keeping {short(p)} (modified).")
                continue
            p.unlink(missing_ok=True)
    strip_mcp_config(base / rec["mcp_json"] if not Path(rec["mcp_json"]).is_absolute() else Path(rec["mcp_json"]),
                     rec.get("created_mcp_json"))
    if rec["scope"] == "local":
        set_exclude(base, [])


def remove_file(base, rel, digest, interactive):
    p = base / rel
    if not p.is_file():
        return
    if sha256(p) != digest and not (interactive and confirm(f"  {short(p)} was modified after install. Delete anyway?")):
        print(f"  Keeping {short(p)} (modified).")
        return
    p.unlink()
    d = p.parent
    while d != base and d.name not in (".kiro", ".claude") and d.is_dir() and not any(d.iterdir()):
        d.rmdir()
        d = d.parent


