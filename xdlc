def base_url(c=None):
    c = c or config()
    return (PROD_URL if c["env"] == "prod" else c["local_url"]).rstrip("/")


def request(method, url, *, body=None, form=None, token=None, timeout=30):
    """→ (status, json | text | None). Lỗi mạng: status 0."""
    headers = {"Accept": "application/json"}
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            status, raw = r.status, r.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        return 0, str(getattr(e, "reason", e))
    if not raw:
        return status, None
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw.decode(errors="replace")


_token_lock = threading.Lock()


def tokens(env=None):
    return load_json(XDLC / "auth.json", {}).get(env or config()["env"])


def save_tokens(env, t):
    auth = load_json(XDLC / "auth.json", {})
    if t is None:
        auth.pop(env, None)
    else:
        auth[env] = t
    save_json(XDLC / "auth.json", auth, private=True)


def _store(env, granted):
    t = {"access_token": granted["access_token"], "refresh_token": granted.get("refresh_token"),
         "expires_at": int(time.time()) + int(granted.get("expires_in") or 3600)}
    save_tokens(env, t)
    return t


def access_token(force_refresh=False):
    """Access token còn hạn của backend đang dùng (tự làm mới), None khi chưa đăng nhập / hết phiên."""
    with _token_lock:
        c = config()
        t = tokens(c["env"])
        if not t:
            return None
        if not force_refresh and t["expires_at"] - 60 > time.time():
            return t["access_token"]
        if not t.get("refresh_token"):
            return None
        status, out = request("POST", base_url(c) + "/oauth/token",
                              form={"grant_type": "refresh_token", "refresh_token": t["refresh_token"],
                                    "client_id": CLIENT_ID})
        if status == 200 and isinstance(out, dict) and out.get("access_token"):
            return _store(c["env"], out)["access_token"]
        if status in (400, 401):  # refresh token hết hạn / tài khoản bị khoá: phải đăng nhập lại
            save_tokens(c["env"], None)
        return None


def whoami():
    """→ (thông tin tài khoản | None, lý do)."""
    token = access_token()
    if not token:
        return None, "chưa đăng nhập (chạy xdlc login)"
    status, out = request("GET", base_url() + "/oauth/userinfo", token=token)
    if status == 401:
        token = access_token(force_refresh=True)
        if token:
            status, out = request("GET", base_url() + "/oauth/userinfo", token=token)
    if status == 200 and isinstance(out, dict):
        return out, ""
    if status == 0:
        return None, f"không kết nối được {base_url()} ({out})"
    return None, "phiên đăng nhập hết hạn: chạy xdlc login" if status == 401 else f"lỗi HTTP {status}"


