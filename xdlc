def _parse_simple_yaml(text):
    """Minimal YAML subset (maps/lists/scalars) for catalog.yaml + manifest.yaml. Stdlib only."""
    def parse_scalar(s):
        s = s.strip()
        if s in ("true", "True"):
            return True
        if s in ("false", "False"):
            return False
        if s in ("null", "Null", "~", ""):
            return None
        if (s.startswith('"') and s.endswith('"')) or (s.startswith("'") and s.endswith("'")):
            return s[1:-1]
        try:
            return int(s)
        except ValueError:
            return s

    lines = []
    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        lines.append(raw.rstrip())

    def indent_of(line):
        return len(line) - len(line.lstrip(" "))

    def parse_block(idx, min_indent):
        # Decide list vs map from first item at this level
        while idx < len(lines) and indent_of(lines[idx]) < min_indent:
            return None, idx
        if idx >= len(lines):
            return None, idx
        if lines[idx].lstrip().startswith("- "):
            return parse_list(idx, min_indent)
        return parse_map(idx, min_indent)

    def parse_map(idx, min_indent):
        out = {}
        while idx < len(lines):
            line = lines[idx]
            ind = indent_of(line)
            if ind < min_indent:
                break
            if ind > min_indent:
                raise Abort(f"Invalid YAML indent: {line.strip()}")
            body = line.strip()
            if body.startswith("- "):
                break
            if ":" not in body:
                raise Abort(f"Invalid YAML line: {body}")
            key, _, rest = body.partition(":")
            key, rest = key.strip(), rest.strip()
            idx += 1
            if rest:
                out[key] = parse_scalar(rest)
                continue
            if idx < len(lines) and indent_of(lines[idx]) > ind:
                child, idx = parse_block(idx, ind + 2)
                out[key] = child
            else:
                out[key] = None
        return out, idx

    def parse_list(idx, min_indent):
        out = []
        while idx < len(lines):
            line = lines[idx]
            ind = indent_of(line)
            if ind < min_indent:
                break
            if ind > min_indent:
                raise Abort(f"Invalid YAML indent: {line.strip()}")
            body = line.strip()
            if not body.startswith("- "):
                break
            item = body[2:].strip()
            idx += 1
            if item and ":" in item and not item.startswith(("http://", "https://")):
                # inline map start "- id: dev"
                key, _, rest = item.partition(":")
                obj = {key.strip(): parse_scalar(rest)}
                if idx < len(lines) and indent_of(lines[idx]) > ind:
                    nested, idx = parse_map(idx, ind + 2)
                    if isinstance(nested, dict):
                        obj.update(nested)
                out.append(obj)
            elif item:
                out.append(parse_scalar(item))
            else:
                child, idx = parse_block(idx, ind + 2)
                out.append(child)
        return out, idx

    data, idx = parse_block(0, 0)
    if idx != len(lines):
        # allow trailing sibling maps at root by merging
        while idx < len(lines):
            more, idx = parse_map(idx, 0)
            if isinstance(data, dict) and isinstance(more, dict):
                data.update(more)
            else:
                break
    return data


