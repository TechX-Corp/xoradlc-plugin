def parse_skill_allowlist(text):
    """Parse AAP NL → [{name, description}]. Raises ValueError on failure."""
    s = (text or "").strip()
    if "```" in s:
        parts = s.split("```")
        for i, block in enumerate(parts):
            if i % 2 == 1:
                body = block.strip()
                if body.lower().startswith("json"):
                    body = body[4:].lstrip()
                s = body
                break
    start, end = s.find("["), s.rfind("]")
    if start < 0 or end <= start:
        raise ValueError("no JSON array")
    data = json.loads(s[start:end + 1])
    if not isinstance(data, list):
        raise ValueError("not a list")
    out = []
    for item in data:
        if not isinstance(item, dict) or not item.get("name"):
            continue
        out.append({"name": str(item["name"]).strip(), "description": str(item.get("description") or item["name"]).strip()})
    if not out:
        raise ValueError("empty skill list")
    return out


