def main(argv):
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    if not argv or argv[0] in ("-h", "--help", "help"):
        if len(argv) == 2 and argv[1] in ("-v", "version"):
            print_help(CMD_HELP["--version"])
        elif len(argv) == 2 and argv[1] in CMD_HELP:
            print_help(CMD_HELP[argv[1]])
        else:
            print_help(HELP.format(v=VERSION))
        return 0
    if argv[0] in ("-v", "--version"):
        argv = ["version", *argv[1:]]
    cmd, rest = argv[0], argv[1:]
    if cmd in COMMANDS and rest[:1] in (["-h"], ["--help"]):
        print_help(CMD_HELP[cmd])
        return 0
    fn = COMMANDS.get(cmd) or HIDDEN.get(cmd)
    if not fn:
        err(f"xdlc: unknown command '{cmd}'.\n")
        print_help(HELP.format(v=VERSION), file=sys.stderr)
        return 2
    try:
        fn(rest)
    except Abort as e:
        if str(e):
            (print if e.code == 0 else err)(str(e) if e.code == 0 else f"xdlc: {e}")
        return e.code
    except KeyboardInterrupt:
        err("\nCancelled.")
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
