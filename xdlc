def cmd_link(argv):
    argv = long_opts(argv)
    wo = step_id = branch = None
    list_only, i = False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--list":
            list_only = True
        elif a in ("--step", "--branch") and i + 1 < len(argv):
            step_id, branch = (argv[i + 1], branch) if a == "--step" else (step_id, argv[i + 1])
            i += 1
        elif not a.startswith("-") and wo is None:
            wo = a
        else:
            raise Abort("xdlc link [WO-…] [-t, --step BƯỚC] [-b, --branch NHÁNH] [-l, --list]", 2)
        i += 1
    root = git_root(Path.cwd())
    if not root:
        raise Abort("Không phải git repo: cd vào repo rồi chạy lại.")
    branch = branch or git_out(root, "branch", "--show-current")
    if not branch:
        raise Abort("Đang không đứng trên nhánh nào (detached HEAD): thêm --branch <tên>.")
    repo_id, _ = repo_identity(root)
    cur = link_of(repo_id, branch)
    steps = my_steps()
    if list_only:
        print(f"Nhánh {branch} ({repo_id}): " + (step_label(cur) if cur else "chưa map work order"))
        print("Các bước bạn đang làm (xdlc link <WO> --step <bước>):" if steps else "Bạn không có bước nào đang làm.")
        for st in steps:
            print(f"  {st['work_order_id']} --step {st['step_id']}   {st.get('work_order_name') or ''} · {st.get('step_name') or ''}")
        return
    if wo:
        cands = [st for st in steps if st["work_order_id"].lower() == wo.lower() and (not step_id or st["step_id"] == step_id)]
        if not cands:
            raise Abort(f"{wo}{' / ' + step_id if step_id else ''} không có trong các bước bạn đang làm. Xem: xdlc link --list")
        if len(cands) > 1:
            raise Abort(f"{wo} có nhiều bước bạn đang làm, thêm --step: " + " | ".join(st["step_id"] for st in cands))
        chosen = cands[0]
    else:
        if not steps:
            raise Abort(f"Bạn không có bước nào đang làm trong Xora DLC ({config()['env']}): không có gì để map.")
        chosen = pick_step(branch, steps)
    save_link(repo_id, branch, chosen)
    print(f"Đã map nhánh {branch} → {step_label(chosen)}" + (f" (trước: {cur['work_order_id']})" if cur and
          (cur["work_order_id"], cur["step_id"]) != (chosen["work_order_id"], chosen["step_id"]) else ""))
    if not pre_push_of(root) and install_pre_push(root):
        print("Đã cài hook git pre-push cho repo này: khi push, sensor gửi cảnh báo về work order trên.")


