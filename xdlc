def fetch_bundle(ref=None):
    """Fetch the plugin repo (XDLC_PLUGIN_DIR, or GitHub tarball for ref) into a temp dir → Path to repo root."""
    tmp = Path(tempfile.mkdtemp(prefix="xdlc-"))
    local = os.environ.get("XDLC_PLUGIN_DIR")
    if local:
        _copy_tree(Path(local).expanduser().resolve(), tmp / "repo")
        return tmp / "repo"
    refs = [ref] if ref else [os.environ.get("XDLC_REF") or f"v{VERSION}", "main"]
    for r in refs:
        url = f"https://codeload.github.com/{REPO}/tar.gz/{urllib.parse.quote(r)}"
        try:
            with urllib.request.urlopen(url, timeout=60) as resp, tarfile.open(fileobj=resp, mode="r|gz") as tar:
                for m in tar:
                    target = (tmp / m.name).resolve()
                    if not str(target).startswith(str(tmp.resolve()) + os.sep) or m.issym() or m.islnk():
                        continue  # do not extract outside the temp dir; skip symlinks
                    tar.extract(m, tmp)
        except (urllib.error.URLError, OSError, tarfile.TarError) as e:
            for p in tmp.iterdir():  # drop partial extract before trying another ref
                shutil.rmtree(p, ignore_errors=True) if p.is_dir() else p.unlink()
            if r != refs[-1]:
                err(f"Could not download {r} ({e}); trying {refs[-1]}.")
                continue
            shutil.rmtree(tmp, ignore_errors=True)
            raise Abort(f"Could not download the plugin from GitHub ({e}).")
        roots = [p for p in tmp.iterdir() if p.is_dir()]
        if len(roots) == 1:
            return roots[0]
    raise Abort("Downloaded plugin package has the wrong structure.")


def install_bundle(src):
    """Replace ~/.xdlc/plugin with src (atomic rename, keep old until done)."""
    if not (src / "roles").is_dir():
        raise Abort(f"roles/ not found in plugin package {src}")
    XDLC.mkdir(parents=True, exist_ok=True)
    new, old = XDLC / "plugin.new", XDLC / "plugin.old"
    for p in (new, old):
        shutil.rmtree(p, ignore_errors=True)
    shutil.move(str(src), str(new))
    if BUNDLE.exists():
        BUNDLE.rename(old)
    new.rename(BUNDLE)
    shutil.rmtree(old, ignore_errors=True)
    shutil.rmtree(src.parent, ignore_errors=True)


