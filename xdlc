class Abort(Exception):
    def __init__(self, msg, code=1):
        super().__init__(msg)
        self.code = code


def err(msg):
    print(msg, file=sys.stderr)


def short(p):
    s = str(p)
    return "~" + s[len(str(HOME)):] if s == str(HOME) or s.startswith(str(HOME) + os.sep) else s


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def save_json(path, data, private=False):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    if private:
        os.chmod(tmp, 0o600)
        os.chmod(path.parent, 0o700)
    os.replace(tmp, path)


def sha256(path):
    return "sha256:" + hashlib.sha256(Path(path).read_bytes()).hexdigest()


def ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        raise Abort("Cần trả lời trên terminal: chạy lệnh trong một terminal tương tác.", 2)


def confirm(prompt):
    return ask(prompt + " [y/N] ").lower() in ("y", "yes", "c", "co", "có")


def _enable_vt():
    """Windows: bật mã điều khiển ANSI cho console (Windows Terminal đã bật sẵn; conhost cũ có thể không)."""
    try:
        import ctypes
        k = ctypes.windll.kernel32
        h, mode = k.GetStdHandle(-11), ctypes.c_uint32()
        return bool(k.GetConsoleMode(h, ctypes.byref(mode)) and k.SetConsoleMode(h, mode.value | 0x0004))
    except (AttributeError, OSError):
        return False


def arrow_keys():
    """Menu phím mũi tên khi stdin/stdout là terminal thật; ngoài ra (pipe, CI, console không hiểu ANSI,
    XDLC_PLAIN=1) thì gõ số."""
    if os.environ.get("XDLC_PLAIN") or os.environ.get("TERM") == "dumb":
        return False
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return False
    try:
        if WINDOWS:
            import msvcrt  # noqa: F401
            return _enable_vt()
        import termios  # noqa: F401
        import tty  # noqa: F401
    except ImportError:
        return False
    return True


WIN_KEYS = {"H": "up", "P": "down"}
KEYS = {"\r": "enter", "\n": "enter", " ": "space", "k": "up", "j": "down", "a": "all", "q": "esc",
        "\x04": "esc", "\x1b": "esc"}


def _key(fd):
    if WINDOWS:
        import msvcrt
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):  # phím đặc biệt: mũi tên = \xe0 + H/P
            return WIN_KEYS.get(msvcrt.getwch(), "")
        if ch == "\x03":
            raise KeyboardInterrupt
        return KEYS.get(ch, "")
    b = os.read(fd, 1)
    if b == b"\x1b":
        if not select.select([fd], [], [], 0.05)[0]:
            return "esc"
        return {b"[A": "up", b"[B": "down", b"OA": "up", b"OB": "down"}.get(os.read(fd, 2), "")
    return KEYS.get(b.decode(errors="ignore"), "")


class _Raw:
    """POSIX: đọc từng phím (cbreak); Windows: msvcrt đã đọc từng phím, không cần gì."""

    def __enter__(self):
        if not WINDOWS:
            import termios
            import tty
            self.fd = sys.stdin.fileno()
            self.old = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd, termios.TCSANOW)  # TCSANOW: không bỏ phím đã gõ sẵn
        return self

    def __exit__(self, *exc):
        if not WINDOWS:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)


def menu(title, labels, multi=False):
    """↑/↓ di chuyển, Enter chọn; multi: Space đánh dấu, a = tất cả. Esc / q huỷ. → chỉ số đã chọn."""
    fd, n = sys.stdin.fileno(), len(labels)
    cols = shutil.get_terminal_size((80, 24)).columns
    width = cols - 1 if cols >= 40 else 10_000  # không biết độ rộng thì không cắt dòng
    tips = ("↑/↓ di chuyển · Space chọn · a chọn tất cả · Enter xác nhận · Esc huỷ" if multi
            else "↑/↓ di chuyển · Enter chọn · Esc huỷ")
    cur, marked, hint, result = 0, set(), None, None
    out = sys.stdout

    def draw(first=False):
        if not first:
            out.write(f"\x1b[{n + 1}A")
        for i, text in enumerate(labels):
            box = ("[x] " if i in marked else "[ ] ") if multi else ""
            out.write("\r\x1b[2K" + f"{'>' if i == cur else ' '} {box}{text}"[:width] + "\n")
        out.write("\r\x1b[2K" + (hint or tips)[:width] + "\n")
        out.flush()

    print(title)
    out.write("\x1b[?25l")
    raw = _Raw().__enter__()
    try:
        draw(first=True)
        while result is None:
            k, hint = _key(fd), None
            if k == "up":
                cur = (cur - 1) % n
            elif k == "down":
                cur = (cur + 1) % n
            elif k == "space" and multi:
                marked ^= {cur}
            elif k == "all" and multi:
                marked = set() if len(marked) == n else set(range(n))
            elif k == "enter":
                if not multi:
                    result = [cur]
                elif marked:
                    result = sorted(marked)
                else:
                    hint = "Chưa chọn mục nào: Space để chọn, Esc để huỷ"
            elif k == "esc":
                raise Abort("Đã huỷ.", 0)
            if result is None:
                draw()
    finally:
        raw.__exit__()
        out.write(f"\x1b[{n + 1}A\x1b[J\x1b[?25h")  # xoá menu, hiện lại con trỏ
        out.flush()
    for i in result:
        print(f"  › {labels[i]}")
    return result


def choose(title, options):
    """options: [(key, label)] → key. Phím mũi tên trên terminal; ngoài ra gõ số đến khi hợp lệ."""
    if arrow_keys():
        return options[menu(title, [lab for _, lab in options])[0]][0]
    print(title)
    for i, (_, label) in enumerate(options, 1):
        print(f"  {i}) {label}")
    while True:
        a = ask("> ")
        if a.isdigit() and 1 <= int(a) <= len(options):
            return options[int(a) - 1][0]
        print(f"Nhập một số từ 1 đến {len(options)}.")


def pick_many(n, answer):
    """'1,3' | '1-2' | 'all' → các chỉ số 0-based, None nếu không hợp lệ."""
    if answer.lower() in ("all", "tất cả"):
        return list(range(n))
    out = []
    for part in answer.replace(" ", "").split(","):
        lo, _, hi = part.partition("-")
        if not lo.isdigit() or (hi and not hi.isdigit()):
            return None
        a, b = int(lo), int(hi or lo)
        if not 1 <= a <= b <= n:
            return None
        out += [i - 1 for i in range(a, b + 1) if i - 1 not in out]
    return out or None


def run(cmd, cwd=None, check=True):
    exe = shutil.which(cmd[0])  # Windows: claude là claude.cmd, phải gọi bằng đường dẫn đầy đủ
    cmd = [exe or cmd[0], *cmd[1:]]
    r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if check and r.returncode != 0:
        raise Abort(f"Lệnh lỗi: {' '.join(cmd)}\n{(r.stderr or r.stdout).strip()}")
    return r


