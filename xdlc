def shell_cmd(argv):
    """Một dòng lệnh shell (bash, sh, cmd đều hiểu): mỗi phần trong ngoặc kép, đường dẫn dùng /."""
    return " ".join('"' + a.replace("\\", "/") + '"' if (" " in a or "\\" in a or "/" in a) else a for a in argv)


